<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-7xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Historial de Órdenes</h1>
        <p class="text-slate-500 font-medium">Gestiona y consulta el registro histórico de comandas</p>
      </div>

      <div class="flex items-center gap-3">

        <%= link_to pos_pickup_path,
        class: "flex items-center gap-2 px-6 py-2 bg-green-500 hover:bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-500/20 transition-all transform hover:-translate-y-0.5" do %>

          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4z"/>
            <path fill-rule="evenodd" d="M3 8h14v7a2 2 0 01-2 2H5a2 2 0 01-2-2V8zm5 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd"/>
          </svg>

          Nuevo Pickup

        <% end %>

        <div class="flex bg-white p-1 rounded-xl shadow-sm border border-slate-200">
          <button class="px-6 py-2 bg-primary text-white font-bold rounded-lg shadow-lg shadow-primary/20">Todas</button>
          <button class="px-6 py-2 text-slate-500 font-bold hover:bg-slate-50 rounded-lg">Hoy</button>
          <button class="px-6 py-2 text-slate-500 font-bold hover:bg-slate-50 rounded-lg">Semana</button>
        </div>

      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">

      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>

        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">
            Órdenes Activas
          </span>

          <span class="text-2xl font-black text-slate-900">
            <%= @active_orders.count %>
          </span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>

        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">
            Total Facturado (Hoy)
          </span>

          <span class="text-2xl font-black text-slate-900">
            <%= number_to_currency @closed_orders.where('created_at > ?', Time.zone.now.beginning_of_day).sum(:total),  unit: "C$",
            separator: ".",
            delimiter: ",",
            format: "%u %n" %>
          </span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          </svg>
        </div>

        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">
            Mesas Atendidas
          </span>

          <span class="text-2xl font-black text-slate-900">
            <%= @closed_orders.count %>
          </span>
        </div>
      </div>

    </div>

    <!-- Active Orders -->
    <% if @active_orders.any? %>

      <!-- Pickup -->
      <div class="mb-12">

        <div class="flex items-center gap-3 mb-6">
          <div class="h-3 w-3 rounded-full bg-orange-500 animate-pulse"></div>
          <h2 class="text-xl font-bold text-slate-800">Órdenes en Proceso Pickup</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <%= render partial: "orders/order_card", collection: @pickup_orders, as: :order %>
        </div>

      </div>

    <% end %>

    <!-- Closed Orders -->
    <div>

      <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/>
        </svg>

        Registros Recientes
      </h2>

      <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">

        <div class="overflow-x-auto">

          <table class="w-full text-left">

            <thead>
              <tr class="bg-slate-50/50 border-b border-slate-100">
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase">Código / Mesa</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase">Cliente</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase">Fecha</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase">Monto</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase text-center">Estado</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-50">

              <% @closed_orders.each do |order| %>

                <tr class="hover:bg-slate-50/50">

                  <td class="px-8 py-5 font-bold text-slate-900">
                    <%= order.order_code %>
                  </td>

                  <td class="px-8 py-5 text-slate-600">
                    <%= order.customer.name %>
                  </td>

                  <td class="px-8 py-5 text-slate-600">
                    <%= l(order.created_at, format: :short) %>
                  </td>

                  <td class="px-8 py-5 font-black text-slate-900">
                    <%= number_to_currency order.total %>
                  </td>

                  <td class="px-8 py-5 text-center">
                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest
                    <%= order.closed? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                      <%= order.status.humanize %>
                    </span>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    </div>
  </div>
</div>