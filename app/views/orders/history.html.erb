<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Historial de Órdenes</h1>
        <p class="text-slate-500 font-medium">Gestiona y consulta el registro histórico de comandas</p>
      </div>
      
      <div class="flex items-center gap-3">
        <%= link_to pos_pickup_path, class: "flex items-center gap-2 px-6 py-2 bg-green-500 hover:bg-green-600 text-white font-bold rounded-xl shadow-lg shadow-green-500/20 transition-all transform hover:-translate-y-0.5" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M4 3a2 2 0 100 4h12a2 2 0 100-4H4z" />
            <path fill-rule="evenodd" d="M3 8h14v7a2 2 0 01-2 2H5a2 2 0 01-2-2V8zm5 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd" />
          </svg>
          Nuevo Pickup
        <% end %>

        <div class="flex bg-white p-1 rounded-xl shadow-sm border border-slate-200">
          <button class="px-6 py-2 bg-primary text-white font-bold rounded-lg shadow-lg shadow-primary/20 transition-all">Todas</button>
          <button class="px-6 py-2 text-slate-500 font-bold hover:bg-slate-50 rounded-lg transition-all">Hoy</button>
          <button class="px-6 py-2 text-slate-500 font-bold hover:bg-slate-50 rounded-lg transition-all">Semana</button>
        </div>
      </div>
    </div>

    <!-- Stats Summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-orange-100 text-orange-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Órdenes Activas</span>
          <span class="text-2xl font-black text-slate-900"><%= @active_orders.count %></span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Total Facturado (Hoy)</span>
          <span class="text-2xl font-black text-slate-900"><%= number_to_currency @closed_orders.where('created_at > ?', Time.zone.now.beginning_of_day).sum(:total) %></span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 flex items-center gap-5">
        <div class="w-14 h-14 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <div>
          <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Mesas Atendidas</span>
          <span class="text-2xl font-black text-slate-900"><%= @closed_orders.count %></span>
        </div>
      </div>
    </div>

    <!-- Active Orders Section -->
    <% if @active_orders.any? %>
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-3 w-3 rounded-full bg-orange-500 animate-pulse"></div>
          <h2 class="text-xl font-bold text-slate-800">Órdenes en Proceso</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% @active_orders.each do |order| %>
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 hover:shadow-xl transition-all group overflow-hidden relative">
              <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                 </svg>
              </div>
              
              <div class="flex justify-between items-start mb-6">
                <div>
                  <%
                    badge_class = case order.order_type
                      when "dine_in" then "bg-orange-50 text-orange-600"
                      when "delivery" then "bg-blue-50 text-blue-600"
                      when "pickup" then "bg-green-50 text-green-600"
                      else "bg-slate-50 text-slate-600"
                    end

                    type_label = case order.order_type
                      when "dine_in" then "Mesa #{order.dining_table.code}"
                      when "delivery" then "Delivery"
                      when "pickup" then "Pickup"
                      else order.order_type&.humanize
                    end
                  %>
                  <span class="px-3 py-1 <%= badge_class %> rounded-lg text-[10px] font-black uppercase tracking-widest mb-2 block w-fit"><%= type_label %></span>
                  <h3 class="text-lg font-bold text-slate-900"><%= order.order_code %></h3>
                  <span class="text-xs text-slate-400 block font-medium"><%= order.customer_name %></span>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-400 block font-medium">Total</span>
                  <span class="text-xl font-black text-slate-900"><%= number_to_currency order.total %></span>
                </div>
              </div>

              <div class="flex flex-col gap-3 mb-6">
                <% order.order_items.limit(3).each do |item| %>
                  <div class="flex justify-between text-sm">
                    <span class="text-slate-600 font-medium"><%= item.quantity.to_i %>x <%= item.product.name %></span>
                    <span class="text-slate-400 font-bold"><%= number_to_currency item.subtotal %></span>
                  </div>
                <% end %>
                <% if order.order_items.count > 3 %>
                  <span class="text-xs text-slate-300 italic">+ <%= order.order_items.count - 3 %> items más</span>
                <% end %>
              </div>

              <div class="flex gap-2">
                <% 
                  target_path = order.dining_table ? pos_table_path(order.dining_table) : pos_order_path(order) 
                %>
                <%= link_to target_path, class: "flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-center font-bold rounded-xl transition-colors text-sm" do %>
                  Ver Detalles
                <% end %>
                <%= link_to new_invoice_path(order_id: order.id), class: "flex-1 py-3 bg-green-500 hover:bg-primary-600 text-white text-center font-bold rounded-xl shadow-lg shadow-primary/20 transition-all text-sm" do %>
                  Facturar
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Closed Orders Section -->
    <div>
      <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Registros Recientes
      </h2>
      
      <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-slate-50/50 border-b border-slate-100">
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest">Código / Mesa</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest">Cliente</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest">Fecha / Hora</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest">Monto</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest text-center">Estado</th>
                <th class="px-8 py-5 text-xs font-black text-slate-400 uppercase tracking-widest text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <% @closed_orders.each do |order| %>
                <tr class="hover:bg-slate-50/50 transition-colors group">
                  <td class="px-8 py-5">
                    <div class="flex flex-col">
                      <span class="text-slate-900 font-bold"><%= order.order_code %></span>
                      <%
                        sub_text_class = case order.order_type
                          when "dine_in" then "text-orange-500"
                          when "delivery" then "text-blue-500"
                          when "pickup" then "text-green-500"
                          else "text-slate-400"
                        end

                        sub_text = case order.order_type
                          when "dine_in" then "Mesa #{order.dining_table.code}"
                          when "delivery" then "Delivery"
                          when "pickup" then "Pickup"
                          else order.order_type&.humanize
                        end
                      %>
                      <span class="text-xs <%= sub_text_class %> font-bold font-mono uppercase"><%= sub_text %></span>
                    </div>
                  </td>
                  <td class="px-8 py-5">
                    <span class="text-slate-600 font-medium"><%= order.customer.name %></span>
                  </td>
                  <td class="px-8 py-5">
                    <div class="flex flex-col">
                      <span class="text-slate-600 font-medium"><%= order.created_at.strftime("%d/%m/%Y") %></span>
                      <span class="text-xs text-slate-400 font-medium"><%= order.created_at.strftime("%I:%M %p") %></span>
                    </div>
                  </td>
                  <td class="px-8 py-5">
                    <span class="text-slate-900 font-black"><%= number_to_currency order.total %></span>
                  </td>
                  <td class="px-8 py-5 text-center">
                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest
                      <%= order.closed? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                      <%= order.status.humanize %>
                    </span>
                  </td>
                  <td class="px-8 py-5 text-right">
                    <button class="p-2 text-slate-400 hover:text-primary hover:bg-primary-50 rounded-lg transition-all">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
