<% content_for :title, "Pedidos y Taller" %>

<div class="mx-auto max-w-7xl space-y-6">
  <%= render "orders/flash" %>

  <!-- Encabezado -->
  <header class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 p-6 md:p-8 text-white shadow-xl shadow-slate-900/10">
    <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-gradient-to-br from-amber-300/30 to-yellow-500/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 left-1/3 h-56 w-56 rounded-full bg-orange-500/10 blur-3xl"></div>

    <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[11px] font-black uppercase tracking-[0.25em] text-amber-300/90">Joyería · Gestión de pedidos</p>
        <h1 class="mt-2 text-3xl md:text-4xl font-black tracking-tight">Pedidos y Taller</h1>
        <p class="mt-2 max-w-xl text-sm text-slate-300">Cotizaciones, encargos personalizados, anticipos y entregas en un solo lugar.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to new_order_path(kind: "standard"), id: "new-standard-order",
              class: "inline-flex items-center gap-2 rounded-2xl bg-white/10 px-5 py-3 text-sm font-bold text-white ring-1 ring-inset ring-white/20 backdrop-blur transition-all hover:bg-white/20 active:scale-95" do %>
          ◇ Venta de vitrina
        <% end %>
        <%= link_to new_order_path(kind: "custom_order"), id: "new-custom-order",
              class: "inline-flex items-center gap-2 rounded-2xl bg-gradient-to-r from-amber-300 to-yellow-400 px-5 py-3 text-sm font-black text-slate-900 shadow-lg shadow-amber-500/30 transition-all hover:brightness-105 active:scale-95" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
          Nuevo encargo
        <% end %>
      </div>
    </div>

    <!-- KPIs -->
    <div class="relative mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
      <%= link_to orders_path(status: "in_workshop"), class: "group rounded-2xl bg-white/5 p-4 ring-1 ring-inset ring-white/10 transition hover:bg-white/10" do %>
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">En taller</p>
        <p class="mt-1 text-2xl font-black text-violet-300"><%= @summary[:in_workshop] %></p>
      <% end %>
      <%= link_to orders_path(status: "ready_for_pickup"), class: "group rounded-2xl bg-white/5 p-4 ring-1 ring-inset ring-white/10 transition hover:bg-white/10" do %>
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Listos para entrega</p>
        <p class="mt-1 text-2xl font-black text-sky-300"><%= @summary[:ready] %></p>
      <% end %>
      <%= link_to orders_path(filter: "overdue"), class: "group rounded-2xl bg-white/5 p-4 ring-1 ring-inset ring-white/10 transition hover:bg-white/10 #{'ring-rose-400/50' if @summary[:overdue].positive?}" do %>
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Vencidos</p>
        <p class="mt-1 text-2xl font-black <%= @summary[:overdue].positive? ? 'text-rose-300' : 'text-slate-300' %>"><%= @summary[:overdue] %></p>
      <% end %>
      <div class="rounded-2xl bg-white/5 p-4 ring-1 ring-inset ring-white/10">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Saldo por cobrar</p>
        <p class="mt-1 text-2xl font-black text-amber-300"><%= order_money(@summary[:receivable]) %></p>
      </div>
    </div>
  </header>

  <!-- Listado -->
  <section class="overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50/40 p-5 md:p-6">
      <!-- Filtros por estado -->
      <nav class="flex flex-wrap gap-2" aria-label="Filtrar por estado">
        <%= order_filter_link "Todos", status: nil, count: @status_counts.values.sum %>
        <% Order::WORKFLOW_STATUSES.each do |status| %>
          <%= order_filter_link Order.status_label(status), status: status, count: @status_counts.fetch(status, 0) %>
        <% end %>
        <% if params[:filter] == "overdue" %>
          <span class="inline-flex items-center gap-2 rounded-full bg-rose-600 px-4 py-2 text-xs font-bold text-white">Vencidos
            <%= link_to "✕", orders_path, class: "opacity-70 hover:opacity-100", title: "Quitar filtro" %>
          </span>
        <% end %>
      </nav>

      <!-- Búsqueda -->
      <%= form_with url: orders_path, method: :get, class: "flex flex-col gap-3 md:flex-row md:items-center", data: { turbo_frame: "_top" } do |f| %>
        <%= f.hidden_field :status, value: params[:status] if params[:status].present? %>
        <%= f.hidden_field :filter, value: params[:filter] if params[:filter].present? %>
        <div class="relative flex-1">
          <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/></svg>
          <%= f.search_field :q, value: params[:q], id: "orders-search", placeholder: "Buscar por código o cliente…",
                class: "block w-full rounded-2xl border-slate-200 bg-white py-3 pl-11 pr-4 text-sm font-medium text-slate-700 shadow-sm focus:border-slate-900 focus:ring-2 focus:ring-slate-900" %>
        </div>
        <%= f.select :kind, [["Todos los tipos", ""], ["◇ Vitrina", "standard"], ["⚒ Taller / Encargo", "custom_order"]],
              { selected: params[:kind] }, id: "orders-kind-filter",
              class: "rounded-2xl border-slate-200 py-3 pl-4 pr-10 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-900 focus:ring-2 focus:ring-slate-900" %>
        <%= f.select :sort, [["Más recientes", ""], ["Fecha promesa", "promised"]],
              { selected: params[:sort] }, id: "orders-sort",
              class: "rounded-2xl border-slate-200 py-3 pl-4 pr-10 text-sm font-semibold text-slate-700 shadow-sm focus:border-slate-900 focus:ring-2 focus:ring-slate-900" %>
        <%= f.submit "Filtrar", id: "orders-filter-submit", class: "cursor-pointer rounded-2xl bg-slate-900 px-6 py-3 text-sm font-black text-white transition hover:bg-slate-800 active:scale-95" %>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-100" id="orders-table">
        <thead class="bg-white">
          <tr class="text-left text-[11px] font-black uppercase tracking-wider text-slate-400">
            <th class="px-6 py-4">Código</th>
            <th class="px-6 py-4">Cliente</th>
            <th class="px-6 py-4">Tipo</th>
            <th class="px-6 py-4 text-right">Total</th>
            <th class="px-6 py-4 text-right">Abonado</th>
            <th class="px-6 py-4 text-right">Saldo</th>
            <th class="px-6 py-4">Fecha promesa</th>
            <th class="px-6 py-4">Estado</th>
            <th class="px-6 py-4"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @orders.any? %>
            <% @orders.each do |order| %>
              <tr class="group transition-colors hover:bg-amber-50/30 <%= 'bg-rose-50/30' if order.overdue? %>" id="<%= dom_id(order) %>">
                <td class="whitespace-nowrap px-6 py-4">
                  <%= link_to order.order_code, order, class: "font-mono text-sm font-black text-slate-900 hover:text-amber-600" %>
                  <p class="text-[11px] font-medium text-slate-400"><%= order.created_at.strftime("%d/%m/%Y") %></p>
                </td>
                <td class="px-6 py-4">
                  <p class="text-sm font-bold text-slate-800"><%= order.customer_name.presence || order.customer&.name %></p>
                  <p class="text-[11px] text-slate-400"><%= pluralize(order.total_items, "pieza", plural: "piezas") %></p>
                </td>
                <td class="whitespace-nowrap px-6 py-4"><%= order_kind_badge(order.order_kind) %></td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-bold text-slate-900"><%= order_money(order.total) %></td>
                <td class="whitespace-nowrap px-6 py-4 text-right">
                  <p class="text-sm font-semibold text-emerald-600"><%= order_money(order.advance_amount) %></p>
                  <div class="ml-auto mt-1.5 h-1 w-20 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-emerald-500" style="width: <%= order.paid_percentage %>%"></div>
                  </div>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-black <%= order.balance_amount.to_d.positive? ? 'text-rose-600' : 'text-slate-300' %>">
                  <%= order_money(order.balance_amount) %>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <div><%= order_status_badge(order.status) %></div>
                  <% if order.invoiced? %>
                    <div class="mt-1">
                      <%= link_to invoice_path(order.linked_invoice), class: "inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-black text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition" do %>
                        🧾 <%= order.linked_invoice.invoice_number %>
                      <% end %>
                    </div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <% unless order.invoiced? %>
                      <%= link_to "Facturar", new_invoice_path(order_id: order.id), 
                            class: "rounded-full bg-amber-400 px-3 py-1.5 text-xs font-black text-slate-900 hover:bg-amber-300 transition shadow-2xs",
                            title: "Convertir en Factura" %>
                    <% end %>
                    <%= link_to "Ver ficha →", order, class: "rounded-full bg-slate-900 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-slate-800" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="px-6 py-24 text-center">
                <div class="mx-auto flex max-w-sm flex-col items-center gap-4">
                  <div class="flex h-16 w-16 items-center justify-center rounded-[1.5rem] bg-gradient-to-br from-amber-100 to-yellow-50 text-3xl">💍</div>
                  <h2 class="text-lg font-black text-slate-900">Sin pedidos por aquí</h2>
                  <p class="text-sm text-slate-500">No hay pedidos que coincidan con los filtros. Crea un nuevo encargo para comenzar.</p>
                  <%= link_to "Limpiar filtros", orders_path, class: "text-xs font-black uppercase tracking-widest text-slate-900 hover:text-amber-600" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <div class="flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 bg-slate-50/50 px-6 py-4">
        <p class="text-sm font-medium text-slate-600">
          Página <span class="font-bold text-slate-900"><%= @page %></span> de <span class="font-bold text-slate-900"><%= @total_pages %></span>
          · <%= @total_count %> pedidos
        </p>
        <nav class="flex gap-2" aria-label="Paginación">
          <% if @page > 1 %>
            <%= link_to "← Anterior", orders_path(request.query_parameters.merge(page: @page - 1)), class: "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
          <% end %>
          <% if @page < @total_pages %>
            <%= link_to "Siguiente →", orders_path(request.query_parameters.merge(page: @page + 1)), class: "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
          <% end %>
        </nav>
      </div>
    <% end %>
  </section>
</div>
