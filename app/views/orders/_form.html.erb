<%= form_with(model: order, class: "contents") do |form| %>
  <% if order.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(order.errors.count, "error") %> prohibited this order from being saved:</h2>

      <ul class="list-disc ml-6">
        <% order.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :tenant_id %>
    <%= form.text_field :tenant_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:tenant_id].none?, "border-red-400 focus:outline-red-600": order.errors[:tenant_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :order_code %>
    <%= form.text_field :order_code, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:order_code].none?, "border-red-400 focus:outline-red-600": order.errors[:order_code].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :dining_table_id %>
    <%= form.text_field :dining_table_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:dining_table_id].none?, "border-red-400 focus:outline-red-600": order.errors[:dining_table_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :customer_id %>
    <%= form.text_field :customer_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:customer_id].none?, "border-red-400 focus:outline-red-600": order.errors[:customer_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :customer_name %>
    <%= form.text_field :customer_name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:customer_name].none?, "border-red-400 focus:outline-red-600": order.errors[:customer_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :string %>
    <%= form.text_field :string, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:string].none?, "border-red-400 focus:outline-red-600": order.errors[:string].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:status].none?, "border-red-400 focus:outline-red-600": order.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :total_items %>
    <%= form.number_field :total_items, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:total_items].none?, "border-red-400 focus:outline-red-600": order.errors[:total_items].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :Total %>
    <%= form.text_field :Total, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": order.errors[:Total].none?, "border-red-400 focus:outline-red-600": order.errors[:Total].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
