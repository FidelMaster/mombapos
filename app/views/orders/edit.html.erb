<% content_for :title, "Editar #{@order.order_code}" %>

<div class="mx-auto max-w-7xl">
  <div class="mb-6 flex flex-col gap-2">
    <%= link_to "← Volver a la ficha", order_path(@order), class: "w-fit text-xs font-black uppercase tracking-widest text-slate-400 hover:text-slate-900" %>
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-black tracking-tight text-slate-900">Editar pedido <span class="font-mono text-amber-600"><%= @order.order_code %></span></h1>
      <%= order_status_badge(@order.status, size: :lg) %>
    </div>
    <% if @order.advance_amount.to_d.positive? %>
      <p class="text-sm text-slate-500">Este pedido ya tiene abonos por <strong class="text-slate-800"><%= order_money(@order.advance_amount) %></strong>; el total no puede quedar por debajo de ese monto.</p>
    <% end %>
  </div>

  <%= render "form", order: @order %>
</div>
