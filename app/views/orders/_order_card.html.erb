<div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 hover:shadow-xl transition-all group overflow-hidden relative">
  <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
    </svg>
  </div>

  <div class="flex justify-between items-start mb-6">
    <div>
      <%
        badge_class = case order.order_type
        when "dine_in" then "bg-orange-50 text-orange-600"
        when "delivery" then "bg-blue-50 text-blue-600"
        when "pickup" then "bg-green-50 text-green-600"
        else "bg-slate-50 text-slate-600"
        end

        type_label = case order.order_type
        when "dine_in" then "Mesa #{order.dining_table&.code}"
        when "delivery" then "Delivery"
        when "pickup" then "Pickup"
        else order.order_type&.humanize
        end
      %>

      <span class="px-3 py-1 <%= badge_class %> rounded-lg text-[10px] font-black uppercase tracking-widest mb-2 block w-fit">
        <%= type_label %>
      </span>

      <h3 class="text-lg font-bold text-slate-900"><%= order.order_code %></h3>
      <span class="text-xs text-slate-400 block font-medium"><%= order.customer_name %></span>
    </div>

    <div class="text-right">
      <span class="text-xs text-slate-400 block font-medium">Total</span>
      <span class="text-xl font-black text-slate-900">
        <%= number_to_currency order.total,  unit: "C$",
            separator: ".",
            delimiter: ",",
            format: "%u %n" %>
      </span>
    </div>
  </div>

  <div class="flex flex-col gap-3 mb-6">
    <% order.order_items.limit(3).each do |item| %>
      <div class="flex justify-between text-sm">
        <span class="text-slate-600 font-medium">
          <%= item.quantity.to_i %>x <%= item.product.name %>
        </span>
        <span class="text-slate-400 font-bold">
            <%= number_to_currency item.subtotal, unit: "C$",
            separator: ".",
            delimiter: ",",
            format: "%u %n" %>
        </span>
      </div>
    <% end %>

    <% if order.order_items.count > 3 %>
      <span class="text-xs text-slate-300 italic">
        + <%= order.order_items.count - 3 %> items más
      </span>
    <% end %>
  </div>

  <div class="flex gap-2">
    <% target_path = order.dining_table ? pos_table_path(order.dining_table) : pos_order_path(order) %>

    <%= link_to target_path,
        class: "flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 text-center font-bold rounded-xl transition-colors text-sm" do %>
      Ver Detalles
    <% end %>

    <%= link_to new_invoice_path(order_id: order.id),
        class: "flex-1 py-3 bg-green-500 hover:bg-primary-600 text-white text-center font-bold rounded-xl shadow-lg shadow-primary/20 transition-all text-sm" do %>
      Facturar
    <% end %>
  </div>
</div>