<% if notice.present? || alert.present? %>
  <div class="mb-6 space-y-2" data-print-hide>
    <% if notice.present? %>
      <div class="flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" role="status">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-[10px] text-white">✓</span>
        <span><%= notice %></span>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800" role="alert">
        <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-500 text-[10px] text-white">!</span>
        <span><%= alert %></span>
      </div>
    <% end %>
  </div>
<% end %>
