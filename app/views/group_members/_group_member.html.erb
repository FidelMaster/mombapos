<div id="<%= dom_id group_member %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Group:</strong>
    <%= group_member.group_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Student:</strong>
    <%= group_member.student_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Score:</strong>
    <%= group_member.score %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= group_member.status %>
  </div>
</div>
