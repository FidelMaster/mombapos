<%= form_with(model: app_module, class: "block max-w-3xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if app_module.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2><%= pluralize(app_module.errors.count, "error") %> prohibited this app_module from being saved:</h2>

      <ul class="list-disc ml-6">
        <% app_module.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :code, class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :code, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": app_module.errors[:code].none?, "ring-red-300 focus:ring-red-500": app_module.errors[:code].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": app_module.errors[:name].none?, "ring-red-300 focus:ring-red-500": app_module.errors[:name].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "flex w-full sm:w-auto justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
  </div>
<% end %>
