<% content_for :title, "Factura ##{@invoice.invoice_number}" %>

<div class="max-w-5xl mx-auto space-y-6">
  <%# 1. Action Header %>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100 print:hidden">
    <div class="flex items-center gap-4">
      <%= link_to invoices_path, class: "p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-500" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      <% end %>
      <div>
        <h1 class="text-xl font-bold text-gray-900">Factura <%= @invoice.invoice_number %></h1>
        <p class="text-xs text-gray-500 font-medium uppercase tracking-wider"><%= @invoice.invoice_type %></p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button type="button" onclick="document.getElementById('ticket-modal-80mm').classList.remove('hidden')" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-slate-800 bg-slate-100 border border-slate-300 rounded-lg hover:bg-slate-200 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.636 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.656" />
        </svg>
        Imprimir Ticket 80mm
      </button>

     <%= link_to edit_invoice_path(@invoice), class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-red-600 rounded-lg hover:bg-red-500 shadow-sm transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
        </svg>
        Anular
      <% end %>

      <%= link_to edit_invoice_path(@invoice), class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-white bg-indigo-600 rounded-lg hover:bg-indigo-500 shadow-sm transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
        </svg>
        Editar
      <% end %>
      
      <%= button_to @invoice, method: :delete, class: "p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors border border-transparent", data: { turbo_confirm: "¿Estás seguro de eliminar esta factura?" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
      <% end %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="p-4 bg-green-50 border-l-4 border-green-500 text-green-700 text-sm font-medium rounded-r-lg print:hidden">
      <%= notice %>
    </div>
  <% end %>

  <%# 2. Documento Estándar (Web) %>
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden print:hidden">
    <%= render @invoice %>
  </div>
</div>

<%# MODAL TICKET TÉRMICO 80MM %>
<div id="ticket-modal-80mm" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden print:p-0 print:static print:bg-white print:block">
  <div class="bg-white rounded-2xl p-6 max-w-sm w-full max-h-[92vh] flex flex-col shadow-2xl print:max-h-none print:shadow-none print:p-0 print:w-full">
    
    <%# Header Modal (Fijo en pantalla) %>
    <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-3 shrink-0 print:hidden">
      <h3 class="font-bold text-slate-900 text-sm">Ticket Térmico (80mm)</h3>
      <button type="button" onclick="document.getElementById('ticket-modal-80mm').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%# CONTENIDO DEL TICKET 80MM (Con scroll si es muy largo) %>
    <div id="thermal-receipt" class="font-mono text-xs text-slate-900 leading-tight space-y-3 overflow-y-auto flex-1 pr-1 print:overflow-visible">
      
      <%# Logo y Encabezado %>
      <div class="text-center border-b border-dashed border-slate-300 pb-3">
        <img src="/logo.jpg" alt="Logo" class="h-12 mx-auto mb-2 object-contain grayscale" onerror="this.style.display='none'">
        <h2 class="font-black text-sm uppercase">Mishell Display</h2>
        <p class="text-[11px]">Los robles frente a plaza Loza</p>
        <p class="text-[11px]">Managua, Nicaragua</p>
        <p class="text-[11px]">Tel: +505 5774-2754</p>
      </div>

      <%# Datos de la Factura %>
      <div class="border-b border-dashed border-slate-300 pb-2 space-y-1">
        <div class="flex justify-between">
          <span>FACTURA:</span>
          <span class="font-bold"><%= @invoice.invoice_number %></span>
        </div>
        <div class="flex justify-between">
          <span>FECHA:</span>
          <span><%= @invoice.created_at&.strftime("%d/%m/%Y %I:%M %p") || Time.current.strftime("%d/%m/%Y %I:%M %p") %></span>
        </div>
        <div class="flex justify-between">
          <span>CLIENTE:</span>
          <span class="font-medium truncate max-w-[160px]"><%= @invoice.try(:customer_name_snapshot).presence || @invoice.try(:customer)&.name || "Consumidor Final" %></span>
        </div>
      </div>

      <%# TABLA DE PRODUCTOS (MULTILÍNEA AUTOMÁTICA) %>
      <div class="border-b border-dashed border-slate-300 pb-2">
        <div class="flex justify-between font-bold border-b border-slate-200 pb-1 mb-1 text-[11px]">
          <span>CANT / DESCRIPCIÓN</span>
          <span>TOTAL</span>
        </div>
        <div class="space-y-2">
          <% items_collection = @invoice.respond_to?(:invoice_items) && @invoice.invoice_items.any? ? @invoice.invoice_items : (@invoice.respond_to?(:items) ? @invoice.items : []) %>
          
          <% items_collection.each do |item| %>
            <% product_obj = item.try(:product) %>
            <% code = product_obj&.try(:product_code) || product_obj&.try(:sku) %>
            <% name = product_obj&.name || item.try(:product_name) || "Producto" %>
            <% qty = item.quantity %>
            <% total_val = item.try(:total) || item.try(:subtotal_local) || (qty * item.unit_price) %>

            <div class="space-y-0.5">
              <%# Fila Principal: Cantidad + Nombre del Producto + Total alineado a la derecha %>
              <div class="flex justify-between items-start gap-1">
                <span class="font-semibold break-words leading-tight flex-1">
                  <%= qty %>x <%= name %>
                </span>
                <span class="text-right font-bold whitespace-nowrap">
                  C$<%= number_with_precision(total_val, precision: 2, delimiter: ",") %>
                </span>
              </div>
              
              <%# Fila Secundaria: Código de producto/SKU abajo en texto tenue %>
              <% if code.present? %>
                <div class="text-[10px] text-black font-mono font-bold pl-4">
                  CÓD: <%= code %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Resumen de Totales %>
      <div class="border-b border-dashed border-slate-300 pb-2 space-y-1">
        <div class="flex justify-between">
          <span>SUBTOTAL:</span>
          <span>C$<%= number_with_precision(@invoice.try(:subtotal_amount) || @invoice.try(:subtotal_local) || 0, precision: 2, delimiter: ",") %></span>
        </div>
    
        <div class="flex justify-between font-black text-sm pt-1 border-t border-slate-200">
          <span>TOTAL CORDOBAS:</span>
          <span>C$<%= number_with_precision(@invoice.try(:total_local_amount) || @invoice.try(:total_local) || 0, precision: 2, delimiter: ",") %></span>
        </div>

        <div class="flex justify-between font-black text-sm pt-1 border-t border-slate-200">
          <span>TOTAL USD:</span>
          <span>U$<%= number_with_precision(@invoice.try(:total_usd) || @invoice.try(:total_foreign_amount) || 0, precision: 2, delimiter: ",") %></span>
        </div>
      </div>

      <%# Métodos de Pago %>
      <div class="border-b border-dashed border-slate-300 pb-2 space-y-1">
        <p class="font-bold uppercase text-[11px] text-slate-800">Canceló Con:</p>
        
        <% payments_collection = @invoice.respond_to?(:invoice_payments) && @invoice.invoice_payments.any? ? @invoice.invoice_payments : (@invoice.respond_to?(:payments) ? @invoice.payments : []) %>

        <% if payments_collection.any? %>
          <% payments_collection.each do |payment| %>
            <% method_name = payment.try(:payment_method)&.name || payment.try(:payment_method)&.description || payment.try(:payment_method_id) || "Efectivo" %>
            <div class="flex justify-between pl-2">
              <span>• <%= method_name %> (<%= payment.currency %>):</span>
              <span class="font-medium"><%= payment.currency == 'USD' ? '$' : 'C$' %> <%= number_with_precision(payment.amount, precision: 2, delimiter: ",") %></span>
            </div>
          <% end %>
        <% else %>
          <div class="flex justify-between pl-2">
            <span>• Efectivo (NIO):</span>
            <span class="font-medium">C$ <%= number_with_precision(@invoice.try(:paid_amount_local) || @invoice.try(:total_local_amount) || 0, precision: 2, delimiter: ",") %></span>
          </div>
        <% end %>

        <% if @invoice.try(:change_amount_local).to_f > 0 %>
          <div class="flex justify-between pt-1 font-bold">
            <span>CAMBIO / VUELTO:</span>
            <span>C$ <%= number_with_precision(@invoice.change_amount_local, precision: 2, delimiter: ",") %></span>
          </div>
        <% end %>
      </div>

      <%# Pie de Ticket %>
      <div class="text-center pt-2 space-y-1">
        <p class="font-bold">¡GRACIAS POR SU COMPRA!</p>
        <p class="text-[10px] text-slate-500">Conserve este ticket como comprobante.</p>
      </div>

    </div>

    <%# Botones de Acción Modal (Siempre fijos al pie) %>
    <div class="mt-4 flex items-center justify-end gap-3 shrink-0 print:hidden border-t border-slate-200 pt-3">
      <button type="button" onclick="document.getElementById('ticket-modal-80mm').classList.add('hidden')" class="px-4 py-2 border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">
        Cerrar
      </button>
      <button type="button" onclick="window.print()" class="px-4 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-lg shadow-md flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231a1.125 1.125 0 01-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.636 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.656" />
        </svg>
        Imprimir
      </button>
    </div>

  </div>
</div>

<%# REGLAS CSS PARA IMPRESIÓN TÉRMICA 80MM %>
<style>
  @media print {
    @page {
      size: 80mm auto;
      margin: 0;
    }

    /* 1. Oculta el sidebar del layout, encabezados y cualquier elemento ajeno */
    aside,
    nav,
    header,
    footer,
    .print\:hidden,
    .max-w-5xl {
      display: none !important;
    }

    /* 2. Regla de aislamiento: oculta todo por defecto */
    body * {
      visibility: hidden;
    }

    /* 3. Hace visible únicamente el modal del ticket y su contenido */
    #ticket-modal-80mm,
    #ticket-modal-80mm * {
      visibility: visible;
    }

    html, body {
      background: #ffffff !important;
      font-family: monospace !important;
      width: 80mm !important;
      min-height: 100% !important;
      height: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: visible !important;
    }

    /* 4. Coloca el ticket al inicio absoluto de la página */
    #ticket-modal-80mm {
      display: block !important;
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 80mm !important;
      height: auto !important;
      margin: 0 !important;
      padding: 2mm !important;
      background: transparent !important;
    }

    #ticket-modal-80mm > div {
      max-width: 100% !important;
      width: 100% !important;
      max-height: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    #thermal-receipt {
      width: 100% !important;
      font-size: 11px !important;
      line-height: 1.2 !important;
      max-height: none !important;
      overflow: visible !important;
      page-break-inside: auto;
    }
  }
</style>