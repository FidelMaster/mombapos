<% content_for :title, "Métodos de pago" %>

<%= render "shared/resource_table", 
      title: "Métodos de pago", 
      collection: @payment_methods,
      new_path: new_payment_method_path, 
      headers: ["Codigo", "Nombre"] do |payment_method| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= payment_method.code %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= payment_method.name %></div>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Mostrar", payment_method, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Editar", edit_payment_method_path(payment_method), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", payment_method, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar este método de pago?" } %>
        </div>
      </td>
    </tr>
<% end %>
