<%= form_with(model: role, class: "block max-w-4xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if role.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2 class="text-sm font-bold text-red-800"><%= pluralize(role.errors.count, "error") %> impidieron guardar este rol:</h2>
      <ul class="list-disc ml-6 text-sm text-red-700 mt-2">
        <% role.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :name, "Nombre del Rol", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <% if %w[owner admin].include?(role.name&.downcase) %>
      <%= form.text_field :name, readonly: true, class: "block w-full rounded-lg border-0 bg-slate-50 px-3.5 py-2 text-gray-500 shadow-sm ring-1 ring-inset ring-gray-200 sm:text-sm sm:leading-6 cursor-not-allowed" %>
      <p class="mt-2 text-xs text-amber-600 font-semibold">⚠️ Este es un rol del sistema y su nombre no puede ser cambiado.</p>
    <% else %>
      <%= form.text_field :name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": role.errors[:name].none?, "ring-red-300 focus:ring-red-500": role.errors[:name].any?}] %>
    <% end %>
  </div>

  <div class="mb-8">
    <h3 class="text-lg font-bold text-slate-900 mb-2">Permisos del Rol</h3>
    <p class="text-sm text-slate-500 mb-6">Define qué acciones puede realizar este rol en cada módulo del sistema.</p>

    <div class="overflow-hidden border border-slate-100 rounded-2xl">
      <table class="min-w-full divide-y divide-slate-100 text-left">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-xs font-bold text-slate-600 uppercase">Módulo / Recurso</th>
            <% available_actions.each do |action| %>
              <th class="px-6 py-4 text-center text-xs font-bold text-slate-600 uppercase"><%= action.humanize %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% available_subjects.each do |subject_class, subject_label| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-slate-800">
                <%= subject_label %>
              </td>
              <% available_actions.each do |action| %>
                <td class="px-6 py-4 whitespace-nowrap text-center">
                  <% is_checked = role.permissions.exists?(subject_class: subject_class, action: action) %>
                  <%= check_box_tag "permissions[#{subject_class}][]", action, is_checked, id: "perm_#{subject_class.parameterize}_#{action}", class: "h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex gap-4 items-center">
    <%= form.submit "Guardar Rol y Permisos", class: "flex justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
    <%= link_to "Cancelar", roles_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
  </div>
<% end %>
