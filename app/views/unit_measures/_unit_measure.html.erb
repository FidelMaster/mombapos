<div id="<%= dom_id unit_measure %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Inquilino:</strong>
    <%= unit_measure.tenant_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Nombre:</strong>
    <%= unit_measure.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Abreviatura:</strong>
    <%= unit_measure.abbreviation %>
  </div>
</div>
