<% content_for :title, "Editar Unidad de Medida" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar Unidad de Medida</h1>

  <%= render "form", unit_measure: @unit_measure %>

  <%= link_to "Ver Unidad de Medida", @unit_measure, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Volver a Unidades de Medida", unit_measures_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
