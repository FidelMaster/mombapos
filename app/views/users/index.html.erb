<% content_for :title, "Usuarios" %>

<%= render "shared/resource_table", 
      title: "Usuarios", 
      collection: @users,
      new_path: new_user_path, 
      headers: ["Email", "Rol", "Estado", "Acciones"] do |user| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-slate-900 font-medium"><%= user.email %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-slate-100 text-slate-700 uppercase">
          <%= user.app_role&.name || "Sin Rol" %>
        </span>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <% if user.is_active? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            Activo
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700">
            <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
            Inactivo
          </span>
        <% end %>
      </td>

      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Editar", edit_user_path(user), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <% if user != current_user %>
            <%= button_to "Eliminar", user, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de que deseas eliminar este usuario?" } %>
          <% end %>
        </div>
      </td>
    </tr>
<% end %>
