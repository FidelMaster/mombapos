<%= form_with(model: user, class: "block max-w-3xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2 class="text-sm font-bold text-red-800"><%= pluralize(user.errors.count, "error") %> impidieron guardar este usuario:</h2>
      <ul class="list-disc ml-6 text-sm text-red-700 mt-2">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :email, "Correo electrónico", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.email_field :email, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": user.errors[:email].none?, "ring-red-300 focus:ring-red-500": user.errors[:email].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :password, "Contraseña", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <% if user.persisted? %>
      <span class="text-xs text-slate-400 block mb-2">(Dejar en blanco si no deseas cambiarla)</span>
    <% end %>
    <%= form.password_field :password, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": user.errors[:password].none?, "ring-red-300 focus:ring-red-500": user.errors[:password].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.password_field :password_confirmation, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": user.errors[:password_confirmation].none?, "ring-red-300 focus:ring-red-500": user.errors[:password_confirmation].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :role_id, "Rol de usuario", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.select :role_id, Role.where(tenant_id: Current.tenant.id).order(:name).map { |r| [r.name.upcase, r.id] }, { include_blank: "Seleccionar Rol..." }, class: "block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm" %>
  </div>

  <div class="mb-6 flex items-center gap-3">
    <%= form.check_box :is_active, class: "h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" %>
    <%= form.label :is_active, "Usuario Activo", class: "text-sm font-medium text-gray-900" %>
  </div>

  <div class="flex gap-4 items-center">
    <%= form.submit "Guardar", class: "flex justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
    <%= link_to "Cancelar", users_path, class: "text-sm font-semibold leading-6 text-gray-900" %>
  </div>
<% end %>
