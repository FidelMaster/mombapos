<% content_for :title, "Detalle Cuentas por Cobrar - #{@customer.name}" %>

<div class="sm:flex sm:items-center mb-8">
  <div class="sm:flex-auto">
    <h1 class="text-2xl font-semibold text-gray-900">Movimientos de Cuenta: <%= @customer.name %></h1>
    <p class="mt-2 text-sm text-gray-700">Listado detallado de facturas, recibos y notas de crédito.</p>
  </div>
  <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
    <%= link_to 'Volver al listado', document_account_receivables_path, class: "block rounded-md bg-white px-3 py-2 text-center text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
  </div>
</div>

<div class="overflow-hidden bg-white shadow sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6 flex justify-between items-center bg-gray-50 border-b border-gray-200">
    <h3 class="text-base font-semibold leading-6 text-gray-900">Historial de Movimientos</h3>
  </div>
  
  <div class="flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Fecha</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Tipo</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Referencia</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Débito</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Crédito</th>
              <th scope="col" class="px-3 py-3.5 text-right text-sm font-semibold text-gray-900">Saldo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% running_balance = 0 %>
            <% @movements.each do |movement| %>
              <% 
                debit = movement.debit? ? movement.amount : 0
                credit = movement.credit? ? movement.amount : 0
                running_balance += (debit - credit)
              %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-500 sm:pl-0">
                  <%= movement.date.strftime("%d/%m/%Y") rescue movement.date %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">
                    <%= movement.document_type.humanize %>
                  </span>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= movement.document_id %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-gray-900">
                  <%= number_to_currency(debit) if debit > 0 %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right text-gray-900">
                  <%= number_to_currency(credit) if credit > 0 %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-right font-medium <%= running_balance > 0 ? 'text-red-600' : 'text-green-600' %>">
                   <%= number_to_currency(running_balance) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
