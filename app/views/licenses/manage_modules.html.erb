<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-10">
      <%= link_to licenses_path, class: "group inline-flex items-center gap-2 text-slate-400 hover:text-slate-900 font-bold text-sm mb-4 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Regresar a Licencias
      <% end %>
      
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-black text-slate-900 tracking-tight">Configurar Módulos de Licencia</h1>
          <p class="text-slate-500 font-medium tracking-tight">Licencia: <span class="text-slate-900 font-bold"><%= @license.name %></span></p>
        </div>
      </div>
    </div>

    <%= form_with url: update_modules_license_path(@license), method: :post do |f| %>
      <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
        <h3 class="text-lg font-bold text-slate-900 mb-6">Módulos Disponibles</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @app_modules.each do |app_module| %>
            <label class="relative flex items-center p-4 rounded-2xl border-2 transition-all cursor-pointer group hover:bg-slate-50 <%= @license_module_ids.include?(app_module.id) ? 'border-blue-500 bg-blue-50/30' : 'border-slate-100' %>">
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-white border border-slate-100 flex items-center justify-center shadow-sm">
                    <span class="text-xs font-bold text-slate-400 group-hover:text-blue-500 transition-colors"><%= app_module.code.first(2).upcase %></span>
                  </div>
                  <div>
                    <span class="block text-sm font-bold text-slate-700"><%= app_module.name %></span>
                    <span class="block text-xs text-slate-400"><%= app_module.code %></span>
                  </div>
                </div>
              </div>
              
              <div class="ml-4">
                <%= check_box_tag "module_ids[]", app_module.id, @license_module_ids.include?(app_module.id), 
                    class: "w-6 h-6 rounded-lg border-2 border-slate-200 text-blue-600 focus:ring-blue-500 transition-all cursor-pointer",
                    onchange: "this.closest('label').classList.toggle('border-blue-500'); this.closest('label').classList.toggle('bg-blue-50/30'); this.closest('label').classList.toggle('border-slate-100');" %>
              </div>
            </label>
          <% end %>
        </div>

        <div class="mt-10 flex justify-end gap-3">
          <%= link_to "Cancelar", licenses_path, class: "px-6 py-3 text-slate-500 font-bold hover:bg-slate-100 rounded-xl transition-all" %>
          <%= f.submit "Guardar Cambios", class: "px-8 py-3 bg-blue-600 text-white font-black rounded-xl shadow-lg shadow-blue-200 hover:scale-105 transition-all cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
