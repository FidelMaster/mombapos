<%= form_with(model: plan, class: "block max-w-6xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if plan.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2><%= pluralize(plan.errors.count, "error") %> prohibited this plan from being saved:</h2>

      <ul class="list-disc ml-6">
        <% plan.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-8">
    <h3 class="text-lg font-semibold leading-6 text-gray-900 mb-4 border-b pb-2">Información General</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="md:col-span-2">
        <%= form.label :name, "Nombre del plan", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_field :name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:name].none?, "ring-red-300 focus:ring-red-500": plan.errors[:name].any?}] %>
      </div>

       <div>
        <%= form.label :total_duration_in_days, "Duración (días)", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.number_field :total_duration_in_days, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:total_duration_in_days].none?, "ring-red-300 focus:ring-red-500": plan.errors[:total_duration_in_days].any?}] %>
      </div>

      <div>
        <%= form.label :trainer_id, "Instructor", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.collection_select :trainer_id, @trainers, :id, :name, { prompt: "Seleccione un instructor" }, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:trainer_id].none?, "ring-red-300 focus:ring-red-500": plan.errors[:trainer_id].any?}] %>
      </div>

      <div>
        <%= form.label :student_id, "Estudiante", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.collection_select :student_id, @students, :id, :name, { prompt: "Seleccione un estudiante" }, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:student_id].none?, "ring-red-300 focus:ring-red-500": plan.errors[:student_id].any?}] %>
      </div>
      
       <div class="md:col-span-3">
        <%= form.label :description, "Descripción", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_area :description, rows: 3, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:description].none?, "ring-red-300 focus:ring-red-500": plan.errors[:description].any?}] %>
      </div>

       <div class="md:col-span-3">
        <%= form.label :observation, "Observaciones", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_area :observation, rows: 2, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:observation].none?, "ring-red-300 focus:ring-red-500": plan.errors[:observation].any?}] %>
      </div>
    </div>
  </div>

  <div class="mb-8">
    <h3 class="text-lg font-semibold leading-6 text-gray-900 mb-4 border-b pb-2">Evento / Torneo</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :tournament, "Torneo asociado", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_field :tournament, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:tournament].none?, "ring-red-300 focus:ring-red-500": plan.errors[:tournament].any?}] %>
      </div>

       <div>
        <%= form.label :event, "Nombre del evento", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_field :event, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:event].none?, "ring-red-300 focus:ring-red-500": plan.errors[:event].any?}] %>
      </div>

      <div>
        <%= form.label :event_date, "Fecha del evento", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.date_field :event_date, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:event_date].none?, "ring-red-300 focus:ring-red-500": plan.errors[:event_date].any?}] %>
      </div>

      <div>
        <%= form.label :event_observation, "Observaciones del evento", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_field :event_observation, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:event_observation].none?, "ring-red-300 focus:ring-red-500": plan.errors[:event_observation].any?}] %>
      </div>
    </div>
  </div>

   <div class="mb-6 flex items-center gap-3">
    <%= form.label :is_active, "Activo", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.check_box :is_active, class: ["h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600", {"ring-gray-300 focus:ring-indigo-600": plan.errors[:is_active].none?, "ring-red-300 focus:ring-red-500": plan.errors[:is_active].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "Guardar", class: "flex w-full sm:w-auto justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
  </div>
<% end %>
