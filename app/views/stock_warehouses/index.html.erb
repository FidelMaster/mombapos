<% content_for :title, "Control de Stock" %>

<div class="w-full">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <h1 class="font-bold text-4xl">Control de Stock</h1>
    
    <div class="w-full md:w-auto">
      <%= form_with url: stock_warehouses_path, method: :get, class: "flex items-center gap-2" do |f| %>
        <%= f.select :warehouse_id, 
            options_from_collection_for_select(@warehouses, :id, :name, @warehouse&.id),
            { prompt: false },
            { onchange: "this.form.submit()", class: "rounded-lg border-gray-300 text-gray-700 sm:text-sm focus:ring-indigo-600 focus:border-indigo-600" } 
        %>
        <noscript>
          <%= f.submit "Filtrar", class: "btn btn-sm btn-secondary" %>
        </noscript>
      <% end %>
    </div>
  </div>

  <% if @warehouse %>
    <div class="bg-white rounded-xl shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h2 class="font-semibold text-gray-900">
          Existencias en <%= @warehouse.name %>
        </h2>
        <span class="text-xs font-medium px-2 py-1 rounded-full <%= @warehouse.is_active? ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
          <%= @warehouse.is_active? ? 'Activo' : 'Inactivo' %>
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead>
            <tr class="bg-gray-50">
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Código</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Existencia</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Reservado</th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Disponible</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Unidad</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @stocks.each do |stock| %>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= stock.product.name %></div>
                  <div class="text-xs text-gray-500"><%= stock.product.product_type %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= stock.product.product_code %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium text-gray-900">
                  <%= stock.stock_available %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-500">
                  <%= stock.stock_reserved %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-bold text-indigo-600">
                  <%= stock.stock_available.to_f - stock.stock_reserved.to_f %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= stock.product.stock_unit_measure.name rescue "-" %>
                </td>
              </tr>
            <% end %>
            
            <% if @stocks.empty? %>
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                  <p>No hay existencias registradas en este almacén.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-xl border border-dashed border-gray-300">
      <p class="text-gray-500">No hay almacenes disponibles.</p>
    </div>
  <% end %>
</div>
