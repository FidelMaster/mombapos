<div class="space-y-8 animate-fade-in-down">
  <%# Header with Filters %>
  <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 pb-6 border-b border-slate-100">
    <div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tighter">Cierre de Ventas</h1>
      <p class="text-slate-500 mt-1 font-medium">Resumen consolidado de facturación</p>
    </div>
    
    <div class="flex items-center gap-4">
      <%= form_with url: reports_sales_summary_path, method: :get, class: "flex items-center gap-3 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm" do |f| %>
        <div class="flex items-center gap-2 px-3 text-sm font-bold text-slate-700">
          <%= f.date_field :date_from, value: params[:date_from] || Date.current, class: "border-none bg-transparent focus:ring-0 p-0" %>
          <span class="text-slate-300">al</span>
          <%= f.date_field :date_to, value: params[:date_to] || Date.current, class: "border-none bg-transparent focus:ring-0 p-0" %>
        </div>
        <%= f.submit "Generar Reporte", class: "px-6 py-2 bg-indigo-600 text-white rounded-xl font-black text-xs hover:bg-indigo-500 transition-all cursor-pointer shadow-lg shadow-indigo-100" %>
      <% end %>
    </div>
  </div>

  <%# Summary Stats %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm group">
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-4">Total Facturas</p>
      <h3 class="text-4xl font-black text-slate-900 tracking-tighter"><%= @total_count %></h3>
      <p class="mt-8 text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Documentos Emitidos</p>
    </div>

    <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm relative overflow-hidden group">
      <div class="absolute -right-4 -top-4 w-24 h-24 bg-slate-50 rounded-full group-hover:scale-110 transition-transform"></div>
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-4">Subtotal Neto</p>
      <h3 class="text-4xl font-black text-slate-900 tracking-tighter"><%= number_to_currency(@subtotal_sum) %></h3>
      <p class="mt-8 text-[10px] font-bold text-slate-400 uppercase tracking-widest">Antes de descuentos</p>
    </div>

    <div class="bg-slate-900 p-8 rounded-[2.5rem] shadow-2xl shadow-slate-200 text-white relative group">
      <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/5 rounded-full group-hover:scale-125 transition-transform"></div>
      <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500 mb-4">Gran Total Cobrado</p>
      <h3 class="text-4xl font-black tracking-tighter text-indigo-400"><%= number_to_currency(@total_sum) %></h3>
      <div class="mt-8 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
        <span class="text-[10px] font-black uppercase text-slate-400 tracking-widest">Total en Caja</span>
      </div>
    </div>
  </div>

  <%# Detailed Table %>
  <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden mt-10">
    <div class="p-8 border-b border-slate-50 flex items-center justify-between">
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Detalle de Transacciones</h2>
        <button class="text-xs font-black text-slate-400 hover:text-slate-600 transition-colors uppercase tracking-widest">Descargar PDF</button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50/50">
          <tr>
            <th class="px-10 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest"># Factura</th>
            <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente</th>
            <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Subtotal</th>
            <th class="px-10 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Total Local</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @invoices.any? %>
            <% @invoices.each do |invoice| %>
              <tr class="hover:bg-slate-50/30 transition-colors group">
                <td class="px-10 py-6">
                  <span class="text-sm font-black text-slate-900"><%= invoice.invoice_number %></span>
                  <span class="block text-[10px] font-bold text-slate-400 mt-1"><%= invoice.created_at.strftime("%I:%M %p") %></span>
                </td>
                <td class="px-8 py-6">
                  <span class="text-sm font-bold text-slate-700 block"><%= invoice.customer_name_snapshot || invoice.customer&.name %></span>
                </td>
                <td class="px-8 py-6 text-sm font-bold text-slate-500 text-right"><%= number_to_currency(invoice.subtotal_amount) %></td>
                <td class="px-10 py-6 text-sm font-black text-slate-900 text-right"><%= number_to_currency(invoice.total_local_amount) %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="px-10 py-20 text-center">
                <p class="text-slate-300 font-bold italic">No se encontraron ventas para este rango</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
