<div class="space-y-6 lg:space-y-8 animate-fade-in-down p-4 lg:p-0">
  <%# Header with Filters %>
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-100">
    <div>
      <h1 class="text-3xl lg:text-4xl font-black text-slate-900 tracking-tighter">Impacto en Ventas por Producto</h1>
      <p class="text-slate-500 mt-1 font-medium text-sm lg:text-base">Análisis de unidades facturadas por producto</p>
    </div>
    
    <div class="flex items-center gap-4">
      <%= form_with url: reports_inventory_impact_path, method: :get, class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm w-full sm:w-auto" do |f| %>
        <div class="flex items-center justify-center gap-2 px-3 text-xs lg:text-sm font-bold text-slate-700">
          <%= f.date_field :date_from, value: @date_from.to_date, class: "border-none bg-transparent focus:ring-0 p-0 text-center sm:text-left" %>
          <span class="text-slate-300">al</span>
          <%= f.date_field :date_to, value: @date_to.to_date, class: "border-none bg-transparent focus:ring-0 p-0 text-center sm:text-left" %>
        </div>
        <%= f.submit "Filtrar Resultados", class: "px-6 py-2 bg-emerald-600 text-white rounded-xl font-black text-xs hover:bg-emerald-500 transition-all cursor-pointer shadow-lg shadow-emerald-100" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:gap-10">
    <%# Sold Products Table %>
    <section class="bg-white rounded-[1.5rem] lg:rounded-[2.5rem] border border-slate-100 shadow-sm p-6 lg:p-10 flex flex-col">
      <div class="flex items-center gap-4 mb-6 lg:mb-10">
        <div class="p-2.5 lg:p-3 bg-blue-50 text-blue-600 rounded-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 lg:h-7 lg:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl lg:text-2xl font-black text-slate-800 tracking-tight">Ventas Detalladas</h2>
          <p class="text-xs lg:text-sm font-medium text-slate-400">Desglose de unidades vendidas e ingresos por producto</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-separate border-spacing-y-3">
          <thead>
            <tr class="text-[10px] font-black text-slate-400 uppercase tracking-widest uppercase">
              <th class="px-4 pb-2">Producto</th>
              <th class="px-4 pb-2 text-center">Tipo</th>
              <th class="px-4 pb-2 text-right">Cant. Vendida</th>
              <th class="px-4 pb-2 text-right">Ingresos Brutos</th>
            </tr>
          </thead>
          <tbody>
            <% if @detailed_sales.any? %>
              <% @detailed_sales.each do |sale| %>
                <tr class="group hover:bg-slate-50 transition-colors">
                  <td class="bg-slate-50 group-hover:bg-white p-4 rounded-l-2xl border border-r-0 border-slate-100 group-hover:border-blue-100 transition-all">
                    <div class="flex items-center gap-3 text-ellipsis overflow-hidden">
                      <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-xs font-black text-slate-400 border border-slate-100 shrink-0 shadow-sm">
                        <%= sale.product_name[0...2].upcase %>
                      </div>
                      <span class="font-bold text-slate-700 text-sm truncate lg:max-w-md"><%= sale.product_name %></span>
                    </div>
                  </td>
                  <td class="bg-slate-50 group-hover:bg-white p-4 border-y border-slate-100 group-hover:border-blue-100 text-center">
                    <span class="px-3 py-1 <%= sale.p_type == 'K' ? 'bg-amber-100 text-amber-600' : 'bg-slate-200 text-slate-600' %> text-[9px] font-black rounded-lg uppercase tracking-widest shrink-0">
                      <%= sale.p_type == 'K' ? 'COMBO / KIT' : 'PRODUCTO' %>
                    </span>
                  </td>
                  <td class="bg-slate-50 group-hover:bg-white p-4 border-y border-slate-100 group-hover:border-blue-100 text-right font-black text-slate-900 text-base">
                    <%= number_with_delimiter(sale.total_qty) %>
                  </td>
                  <td class="bg-slate-50 group-hover:bg-white p-4 rounded-r-2xl border border-l-0 border-slate-100 group-hover:border-blue-100 text-right font-black text-blue-600 text-base">
                    C$ <%= number_with_precision(sale.total_rev, precision: 2) %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="py-20 text-center text-slate-300 font-bold italic">No hay ventas registradas en el periodo seleccionado</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</div>
