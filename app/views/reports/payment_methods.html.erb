<div class="space-y-6 lg:space-y-8 animate-fade-in-down p-4 lg:p-0">
  <%# Header with Filters %>
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-slate-100">
    <div>
      <h1 class="text-3xl lg:text-4xl font-black text-slate-900 tracking-tighter">Medios de Pago</h1>
      <p class="text-slate-500 mt-1 font-medium text-sm lg:text-base">Distribución de recaudación por método y moneda</p>
    </div>
    
    <div class="flex items-center gap-4">
      <%= form_with url: reports_payment_methods_path, method: :get, class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-3 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm w-full sm:w-auto" do |f| %>
        <div class="flex items-center justify-center gap-2 px-3 text-xs lg:text-sm font-bold text-slate-700">
          <%= f.date_field :date_from, value: params[:date_from] || Date.current, class: "border-none bg-transparent focus:ring-0 p-0 text-center sm:text-left" %>
          <span class="text-slate-300">al</span>
          <%= f.date_field :date_to, value: params[:date_to] || Date.current, class: "border-none bg-transparent focus:ring-0 p-0 text-center sm:text-left" %>
        </div>
        <%= f.submit "Filtrar", class: "px-6 py-2 bg-emerald-600 text-white rounded-xl font-black text-xs hover:bg-emerald-500 transition-all cursor-pointer shadow-lg shadow-emerald-100" %>
      <% end %>
    </div>
  </div>

  <%# Breakdown Cards %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
    <%# Summary Table Section %>
    <section class="bg-white rounded-[1.5rem] lg:rounded-[2.5rem] border border-slate-100 shadow-sm p-6 lg:p-10 flex flex-col">
       <div class="flex items-center gap-4 mb-6 lg:mb-10">
        <div class="p-2.5 lg:p-3 bg-indigo-50 text-indigo-600 rounded-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 lg:h-7 lg:w-7" viewBox="0 0 20 20" fill="currentColor">
            <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z" />
            <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl lg:text-2xl font-black text-slate-800 tracking-tight">Recaudación</h2>
          <p class="text-xs lg:text-sm font-medium text-slate-400">Desglose detallado por divisa</p>
        </div>
      </div>

      <div class="space-y-4 lg:space-y-6 flex-1">
        <% if @payments.any? %>
          <% @payments.each do |payment| %>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 lg:p-6 rounded-2xl lg:rounded-3xl bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-md transition-all cursor-pointer group gap-4">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl lg:rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-900 group-hover:text-indigo-600 transition-colors shrink-0">
                  <span class="text-[9px] lg:text-[10px] font-black"><%= payment.currency %></span>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <p class="text-sm lg:text-base font-black text-slate-800 truncate"><%= payment.method_name %></p>
                    <span class="px-2 py-0.5 bg-slate-200 text-slate-600 text-[8px] font-black rounded-md uppercase tracking-tighter shrink-0">
                      <%= payment.currency %>
                    </span>
                  </div>

                  <% if payment.respond_to?(:bank_name) && payment.bank_name.present? %>
                    <p class="text-[10px] lg:text-xs font-bold text-indigo-500 mt-0.5 truncate"><%= payment.bank_name %></p>
                  <% end %>
                  
                  <% if payment.respond_to?(:bank_account_name) && payment.bank_account_name.present? %>
                    <p class="text-[10px] lg:text-xs font-bold text-indigo-500 mt-0.5 truncate"><%= payment.bank_account_name %></p>
                  <% end %>
                  
                  <p class="text-[8px] lg:text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1"><%= payment.payment_count %> transacciones</p>
                </div>
              </div>
              <div class="text-left sm:text-right shrink-0">
                <p class="text-lg lg:text-xl font-black text-slate-900">
                  <%= payment.currency == 'NIO' ? 'C$' : '$' %> <%= number_with_precision(payment.total_amount, precision: 2) %>
                </p>
                <div class="w-24 sm:ml-auto bg-slate-200 h-1.5 rounded-full mt-2 overflow-hidden">
                    <% currency_total = @totals_by_currency[payment.currency] || 1 %>
                    <div class="bg-indigo-500 h-full" style="width: <%= (payment.total_amount / currency_total * 100).round %>%"></div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
           <div class="py-10 lg:py-20 text-center">
              <p class="text-slate-300 font-bold italic">No hay transacciones en este período</p>
           </div>
        <% end %>
      </div>

      <%# Detailed Totals Section %>
      <div class="mt-8 lg:mt-10 pt-8 lg:pt-10 border-t border-slate-100 space-y-4">
         <span class="text-[9px] lg:text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4 block text-center lg:text-left">Resumen Consolidado</span>
         
         <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
           <% @totals_by_currency.each do |currency, total| %>
             <div class="p-5 lg:p-6 rounded-2xl lg:rounded-3xl bg-slate-900 text-white relative overflow-hidden">
               <div class="absolute -right-4 -bottom-4 w-12 h-12 lg:w-16 lg:h-16 bg-white/5 rounded-full rotate-12"></div>
               <p class="text-[9px] lg:text-[10px] font-black uppercase tracking-widest opacity-50 mb-1">Total <%= currency %></p>
               <p class="text-xl lg:text-2xl font-black">
                 <%= currency == 'NIO' ? 'C$' : '$' %> <%= number_with_precision(total, precision: 2) %>
               </p>
             </div>
           <% end %>
         </div>
      </div>
    </section>

    <%# Legend or Visual Placeholder %>
    <section class="bg-slate-900 rounded-[1.5rem] lg:rounded-[2.5rem] p-8 lg:p-12 text-white flex flex-col justify-between relative overflow-hidden shadow-2xl shadow-indigo-200/50">
       <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 to-transparent"></div>
       
       <div class="relative z-10">
          <div class="w-12 h-12 lg:w-16 lg:h-16 bg-white/10 rounded-2xl flex items-center justify-center mb-6 lg:mb-10">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 lg:w-8 lg:h-8 text-indigo-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
            </svg>
          </div>

          <h3 class="text-2xl lg:text-3xl font-black tracking-tight mb-4">Análisis de Ingresos</h3>
          <p class="text-slate-400 font-medium leading-relaxed mb-6 lg:mb-10 text-sm lg:text-base">
            Este reporte agrupa la recaudación por el tipo de moneda recibida y el método aplicado. 
            Es vital para el cuadre de caja diario separar los ingresos en <span class="text-indigo-400 font-bold">NIO</span> de los de <span class="text-emerald-400 font-bold">USD</span>.
          </p>
          
          <div class="space-y-4 lg:space-y-6">
             <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
                <div class="w-2 h-2 rounded-full bg-indigo-500"></div>
                <div>
                  <p class="text-xs lg:text-sm font-bold">Criterio de Validación</p>
                  <p class="text-[8px] lg:text-[10px] text-slate-500 font-bold uppercase">Solo facturas emitidas</p>
                </div>
             </div>
             <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
                <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                <div>
                  <p class="text-xs lg:text-sm font-bold">Transparencia Bancaria</p>
                  <p class="text-[8px] lg:text-[10px] text-slate-500 font-bold uppercase">Muestra cuenta de destino en transferencias</p>
                </div>
             </div>
          </div>
       </div>

       <div class="relative z-10 mt-10 lg:mt-12 pt-6 lg:pt-8 border-t border-white/10 text-[8px] lg:text-[10px] font-black text-slate-500 uppercase tracking-widest text-center">
         Sistema de Reportes POS <%= Time.current.year %>
       </div>
    </section>
  </div>
</div>
