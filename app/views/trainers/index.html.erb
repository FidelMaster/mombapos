<% content_for :title, "Instructores" %>

<%= render "shared/resource_table", 
      title: "Instructores", 
      collection: @trainers,
      new_path: new_trainer_path, 
      headers: [ "Nombre", "Email", "Teléfono", "Departamento", "Tarifa/Hr" ] do |trainer| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-medium text-gray-900"><%= trainer.name %></div>
      </td>
       <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= trainer.email %></div>
      </td>
       <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= trainer.phone %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= trainer.department&.name %></div>
        <div class="text-xs text-gray-500"><%= trainer.municipality&.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= number_to_currency(trainer.rate_per_hour) %></div>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Ver", trainer, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Editar", edit_trainer_path(trainer), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", trainer, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar este instructor?" } %>
        </div>
      </td>
    </tr>
<% end %>
