<% content_for :title, "Editar Instructor" %>

<div class="w-full">
  <div class="flex items-center justify-between mb-8">
    <h1 class="font-bold text-4xl">Editar instructor</h1>
    <div class="flex gap-2">
      <%= link_to "Mostrar", @trainer, class: "rounded-lg py-2 px-4 bg-gray-100 hover:bg-gray-200 font-medium" %>
      <%= link_to "Regresar", trainers_path, class: "rounded-lg py-2 px-4 bg-gray-100 hover:bg-gray-200 font-medium" %>
    </div>
  </div>

  <%= render "form", trainer: @trainer %>
</div>
