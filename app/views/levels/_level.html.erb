<div id="<%= dom_id level %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Tenant:</strong>
    <%= level.tenant_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= level.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Order:</strong>
    <%= level.order %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= level.is_active? ? "Yes" : "No" %>
  </div>
</div>
