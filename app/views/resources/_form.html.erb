<%= form_with(model: resource, class: "block max-w-4xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if resource.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2><%= pluralize(resource.errors.count, "error") %> prohibited this resource from being saved:</h2>

      <ul class="list-disc ml-6">
        <% resource.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :name, "Nombre del recurso", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": resource.errors[:name].none?, "ring-red-300 focus:ring-red-500": resource.errors[:name].any?}] %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <div>
      <%= form.label :resource_type, "Tipo de recurso", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
       <%= form.select :resource_type, ["Documento", "Video", "Enlace", "Imagen"], { prompt: "Seleccione un tipo" }, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": resource.errors[:resource_type].none?, "ring-red-300 focus:ring-red-500": resource.errors[:resource_type].any?}] %>
    </div>

    <div>
      <%= form.label :level_id, "Nivel asociado", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
      <%= form.collection_select :level_id, @levels, :id, :name, { prompt: "Seleccione un nivel" }, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": resource.errors[:level_id].none?, "ring-red-300 focus:ring-red-500": resource.errors[:level_id].any?}] %>
    </div>
  </div>

  <div class="mb-6">
    <%= form.label :location_url, "URL / Ubicación", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :location_url, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": resource.errors[:location_url].none?, "ring-red-300 focus:ring-red-500": resource.errors[:location_url].any?}] %>
  </div>

  <div class="mb-6 flex items-center gap-3">
    <%= form.label :is_active, "Activo", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.check_box :is_active, class: ["h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600", {"ring-gray-300 focus:ring-indigo-600": resource.errors[:is_active].none?, "ring-red-300 focus:ring-red-500": resource.errors[:is_active].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "Guardar", class: "flex w-full sm:w-auto justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
  </div>
<% end %>
