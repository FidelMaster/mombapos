<div id="<%= dom_id resource %>" class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
  
  <div>
    <strong class="block text-sm font-medium text-gray-500">Nombre</strong>
    <span class="text-gray-900 text-lg"><%= resource.name %></span>
  </div>

  <div>
    <strong class="block text-sm font-medium text-gray-500">Tipo</strong>
    <span class="text-gray-900"><%= resource.resource_type %></span>
  </div>
  
  <div>
    <strong class="block text-sm font-medium text-gray-500">Nivel</strong>
    <span class="text-gray-900"><%= resource.level&.name %></span>
  </div>

  <div>
    <strong class="block text-sm font-medium text-gray-500">Estado</strong>
    <span class="text-gray-900"><%= resource.is_active ? "Activo" : "Inactivo" %></span>
  </div>

  <div class="col-span-full">
    <strong class="block text-sm font-medium text-gray-500">Ubicación / URL</strong>
    <a href="<%= resource.location_url %>" target="_blank" class="text-indigo-600 hover:underline break-all"><%= resource.location_url %></a>
  </div>
</div>
