<%= form_with(model: group, class: "space-y-8", data: { controller: "group" }) do |form| %>
  <% if group.errors.any? %>
    <div id="error_explanation" class="bg-red-50 border-l-4 border-red-400 p-4 rounded-md">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= pluralize(group.errors.count, "error") %> impidieron guardar este grupo:
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% group.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Sección 1: Información Básica -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
    <div class="mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Información General</h2>
        <p class="text-sm text-slate-500">Define los detalles principales del grupo</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="space-y-2">
        <%= form.label :name, "Nombre del Grupo", class: "text-sm font-medium text-slate-700" %>
        <%= form.text_field :name, 
            placeholder: "Ej: Apertura Espanhola 12:00",
            class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :trainer_id, "Entrenador / Instructor", class: "text-sm font-medium text-slate-700" %>
        <%= form.collection_select :trainer_id, Trainer.all, :id, :name, 
            { prompt: "Selecciona un entrenador" }, 
            { class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" } %>
      </div>

      <div class="md:col-span-2 space-y-2">
        <%= form.label :description, "Descripción", class: "text-sm font-medium text-slate-700" %>
        <%= form.text_area :description, 
            rows: 3, 
            placeholder: "Breve descripción de los objetivos del grupo...",
            class: "flex min-h-[80px] w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>
    </div>
  </div>

  <!-- Sección 2: Programación -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
    <div class="mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <div class="p-2 bg-amber-50 rounded-lg text-amber-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Horarios y Fechas</h2>
        <p class="text-sm text-slate-500">Planifica cuándo ocurrirá la ejecución</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="space-y-2">
        <%= form.label :execution_date, "Fecha Inicio", class: "text-sm font-medium text-slate-700" %>
        <%= form.date_field :execution_date, class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :end_date, "Fecha Fin", class: "text-sm font-medium text-slate-700" %>
        <%= form.date_field :end_date, class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :execution_hour, "Hora", class: "text-sm font-medium text-slate-700" %>
        <%= form.time_field :execution_hour, class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :duration_in_minutes, "Duración (minutos)", class: "text-sm font-medium text-slate-700" %>
        <%= form.number_field :duration_in_minutes, class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :status, "Estado", class: "text-sm font-medium text-slate-700" %>
        <%= form.select :status, Group.statuses.keys.map { |k| [k.humanize, k] }, 
            {}, 
            { class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" } %>
      </div>
    </div>
  </div>

  <!-- Sección 3: Capacidad y Costos -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
    <div class="mb-6 flex items-center gap-2 border-b border-slate-100 pb-4">
      <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-slate-900">Capacidad e Ingresos</h2>
        <p class="text-sm text-slate-500">Gestiona el cupo y el valor económico</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="space-y-2">
        <%= form.label :max_students, "Cupo Máximo", class: "text-sm font-medium text-slate-700" %>
        <%= form.number_field :max_students, 
            data: { 
              group_target: "maxStudents",
              action: "input->group#calculate"
            },
            class: "flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
      </div>

      <div class="space-y-2">
        <%= form.label :price, "Precio por Estudiante", class: "text-sm font-medium text-slate-700" %>
        <div class="relative">
          <span class="absolute left-3 top-2 text-slate-400">$</span>
          <%= form.number_field :price, 
              step: 0.01, 
              data: { 
                group_target: "price",
                action: "input->group#calculate"
              },
              class: "flex h-10 w-full rounded-md border border-slate-200 bg-white pl-7 pr-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200" %>
        </div>
      </div>

      <div class="space-y-2">
        <%= form.label :total_incomes, "Ingresos Estimados", class: "text-sm font-medium text-slate-700" %>
        <div class="relative">
          <span class="absolute left-3 top-2 text-slate-400">$</span>
          <%= form.number_field :total_incomes, 
              step: 0.01, 
              data: { group_target: "totalIncomes" },
              class: "flex h-10 w-full rounded-md border border-slate-200 bg-slate-50 pl-7 pr-3 py-2 text-sm ring-offset-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 transition-all duration-200", 
              readonly: true %>
        </div>
        <p class="text-xs text-slate-400 italic">Calculado automáticamente</p>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancelar", groups_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" %>
    <%= form.submit "Guardar Grupo", 
        class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all active:scale-95 cursor-pointer" %>
  </div>
<% end %>

