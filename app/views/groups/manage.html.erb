<% content_for :title, "Gestionar Grupo: #{@group.name}" %>

<div class=" mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <%= link_to "Grupos", groups_path, class: "text-sm text-slate-500 hover:text-indigo-600 transition-colors" %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 11H3a1 1 0 110-2h7.586l-3.293-3.293a1 1 0 011.414-1.414l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="ml-1 text-sm font-medium text-slate-400 md:ml-2">Gestionar</span>
            </div>
          </li>
        </ol>
      </nav>
      <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Gestionar Grupo: <%= @group.name %></h1>
      <p class="mt-2 text-slate-500">Configura estudiantes, notas y actividades del curso.</p>
    </div>

    <div class="flex gap-3">
      <%= link_to edit_group_path(@group), class: "inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-lg text-slate-700 hover:bg-slate-50 font-medium shadow-sm transition-all" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Editar Info Básica
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Sidebar: Estudiantes (Añadir Nuevo) -->
    <div class="lg:col-span-1 space-y-8">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
            Inscribir Estudiante
          </h2>
        </div>
        <div class="p-6">
          <%= form_with(model: @new_member, url: group_members_path) do |f| %>
            <%= f.hidden_field :group_id %>
            <div class="space-y-4">
              <div class="space-y-2">
                <%= f.label :student_id, "Seleccionar Estudiante", class: "text-sm font-medium text-slate-700" %>
                <%= f.collection_select :student_id, Student.all, :id, :name, { prompt: "Buscar estudiante..." }, { class: "w-full rounded-lg border-slate-200 text-sm focus:ring-indigo-500 focus:border-indigo-500" } %>
              </div>
              <div class="space-y-2">
                <%= f.label :status, "Estado Inicial", class: "text-sm font-medium text-slate-700" %>
                <%= f.select :status, GroupMember.statuses.keys.map { |k| [k, k] }, {}, { class: "w-full rounded-lg border-slate-200 text-sm focus:ring-indigo-500 focus:border-indigo-500" } %>
              </div>
              <%= f.submit "Inscribir al Grupo", class: "w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition-all shadow-md shadow-indigo-100" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="rounded-2xl p-6 shadow-lg shadow-indigo-200">
        <h3 class="font-bold text-lg mb-2">Resumen del Grupo</h3>
        <div class="space-y-3 opacity-90 text-sm">
          <div class="flex justify-between border-b border-indigo-500/30 pb-2">
            <span>Estudiantes inscritos:</span>
            <span class="font-bold"><%= @group_members.count %> / <%= @group.max_students %></span>
          </div>
          <div class="flex justify-between border-b border-indigo-500/30 pb-2">
            <span>Tareas activas:</span>
            <span class="font-bold"><%= @group_tasks.count %></span>
          </div>
          <div class="flex justify-between">
            <span>Instructor:</span>
            <span class="font-bold"><%= @group.trainer.name %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content: Tabla de Estudiantes y Tareas -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Sección Tareas -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Tareas Generales
          </h2>
          <button onclick="document.getElementById('task-form-modal').classList.remove('hidden')" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva Tarea
          </button>
        </div>
        <div class="divide-y divide-slate-100">
          <% if @group_tasks.any? %>
            <% @group_tasks.each do |task| %>
              <% next if task.new_record? %>
              <div class="p-4 hover:bg-slate-50 transition-colors flex items-center justify-between group">
                <div>
                  <h4 class="font-semibold text-slate-800"><%= task.name %></h4>
                  <p class="text-xs text-slate-500 mt-1"><%= task.description %></p>
                  <div class="flex gap-4 mt-2">
                    <span class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Inicio: <%= task.start_date %></span>
                    <span class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Fin: <%= task.end_date %></span>
                  </div>
                </div>
                <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                  <%= button_to group_task_path(task), method: :delete, data: { confirm: "¿Eliminar tarea?" }, class: "p-2 text-red-500 hover:bg-red-50 rounded-lg" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="p-8 text-center text-slate-400 italic text-sm">
              No hay tareas asignadas a este grupo.
            </div>
          <% end %>
        </div>
      </div>

      <!-- Sección Estudiantes Inscritos -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 bg-emerald-50/30">
          <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            Estudiantes y Calificaciones
          </h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-slate-50 text-[10px] uppercase tracking-wider font-bold text-slate-500">
                <th class="px-6 py-4">Estudiante</th>
                <th class="px-6 py-4">Estado</th>
                <th class="px-6 py-4">Calificación (Score)</th>
                <th class="px-6 py-4 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @group_members.each do |member| %>
                <% next if member.new_record? %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4">
                    <div class="font-medium text-slate-900"><%= member.student.name %></div>
                    <div class="text-xs text-slate-500"><%= member.student.contact_email %></div>
                  </td>
                  <td class="px-6 py-4">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase <%= member.status == 'Activo' ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                      <%= member.status %>
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <%= form_with(model: member, class: "flex items-center gap-2") do |f| %>
                      <%= f.number_field :score, step: 0.1, class: "w-20 rounded-lg border-slate-200 text-sm focus:ring-indigo-500 focus:border-indigo-500 py-1" %>
                      <%= f.submit "Ok", class: "px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded text-xs font-bold transition-colors" %>
                    <% end %>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <%= button_to group_member_path(member), method: :delete, data: { confirm: "¿Retirar estudiante del grupo?" }, class: "text-red-400 hover:text-red-600 p-2" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              <% if @group_members.reject(&:new_record?).empty? %>
                <tr>
                  <td colspan="4" class="px-6 py-12 text-center text-slate-400 italic">No hay estudiantes inscritos todavía.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal para Nueva Tarea -->
<div id="task-form-modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl">
    <div class="p-6 border-b border-slate-100 flex items-center justify-between">
      <h3 class="text-xl font-bold text-slate-900">Nueva Tarea / Actividad</h3>
      <button onclick="document.getElementById('task-form-modal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-6">
      <%= form_with(model: @new_task, url: group_tasks_path) do |f| %>
        <%= f.hidden_field :group_id %>
        <div class="space-y-4">
          <div class="space-y-1">
            <%= f.label :name, "Título de la Tarea", class: "text-sm font-medium text-slate-700" %>
            <%= f.text_field :name, placeholder: "Ej: Examen Parcial o Tarea de Lectura", class: "w-full rounded-lg border-slate-200 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="space-y-1">
            <%= f.label :description, "Descripción", class: "text-sm font-medium text-slate-700" %>
            <%= f.text_area :description, rows: 2, class: "w-full rounded-lg border-slate-200 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-1">
              <%= f.label :start_date, "Fecha Inicio", class: "text-sm font-medium text-slate-700" %>
              <%= f.date_field :start_date, class: "w-full rounded-lg border-slate-200 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
            <div class="space-y-1">
              <%= f.label :end_date, "Fecha Límite", class: "text-sm font-medium text-slate-700" %>
              <%= f.date_field :end_date, class: "w-full rounded-lg border-slate-200 focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
            </div>
          </div>
          <div class="space-y-1">
            <%= f.label :observation, "Observaciones Extra (Opcional)", class: "text-sm font-medium text-slate-700" %>
            <%= f.text_area :observation, rows: 2, class: "w-full rounded-lg border-slate-200 focus:ring-indigo-500 focus:border-indigo-500" %>
          </div>
          <div class="flex gap-3 justify-end pt-2">
            <button type="button" onclick="document.getElementById('task-form-modal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 transition-colors">Cancelar</button>
            <%= f.submit "Crear Tarea", class: "px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition-all shadow-md" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
