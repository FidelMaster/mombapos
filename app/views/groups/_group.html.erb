<div id="<%= dom_id group %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Tenant:</strong>
    <%= group.tenant_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Trainer:</strong>
    <%= group.trainer_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= group.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= group.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Execution date:</strong>
    <%= group.execution_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= group.end_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Execution hour:</strong>
    <%= group.execution_hour %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= group.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max students:</strong>
    <%= group.max_students %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Duration in minutes:</strong>
    <%= group.duration_in_minutes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= group.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Total incomes:</strong>
    <%= group.total_incomes %>
  </div>
</div>
