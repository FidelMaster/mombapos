<% content_for :title, "Nuevo Grupo" %>

<div class=" px-4 py-8">
  <div class="mb-8">
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <%= link_to "Grupos", groups_path, class: "text-sm text-slate-500 hover:text-indigo-600 transition-colors" %>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 11H3a1 1 0 110-2h7.586l-3.293-3.293a1 1 0 011.414-1.414l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
            <span class="ml-1 text-sm font-medium text-slate-400 md:ml-2">Nuevo</span>
          </div>
        </li>
      </ol>
    </nav>
    <h1 class="text-3xl font-bold text-slate-900 tracking-tight">Crear Nuevo Grupo</h1>
    <p class="mt-2 text-slate-500">Configura una nueva sesión de entrenamiento para tus estudiantes.</p>
  </div>

  <div class="bg-slate-50 border border-slate-100 rounded-2xl p-2 sm:p-4">
    <%= render "form", group: @group %>
  </div>
</div>
