<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-2xl mx-auto">
    <div class="mb-8">
      <%= link_to dining_tables_path, class: "text-slate-400 hover:text-slate-900 font-bold text-sm flex items-center gap-2 mb-4 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Regresar al listado
      <% end %>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Nueva Mesa</h1>
      <p class="text-slate-500 font-medium">Define el nombre y capacidad para tu sistema de comanda</p>
    </div>

    <%= render "form", dining_table: @dining_table %>
  </div>
</div>
