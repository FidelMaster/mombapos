<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Administración de Mesas</h1>
        <p class="text-slate-500 font-medium">Configura y gestiona las mesas de tu restaurante</p>
      </div>

      
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Total Mesas</span>
        <span class="text-2xl font-black text-slate-900"><%= @dining_tables.count %></span>
      </div>
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Libres</span>
        <span class="text-2xl font-black text-green-600"><%= @dining_tables.free.count %></span>
      </div>
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Ocupadas</span>
        <span class="text-2xl font-black text-red-600"><%= @dining_tables.occupied.count %></span>
      </div>
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100">
        <span class="block text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Capacidad Total</span>
        <span class="text-2xl font-black text-blue-600"><%= @dining_tables.sum(:capacity) %> pers.</span>
      </div>
    </div>

<%= render "shared/resource_table", 
      title: "Mesas", 
      collection: @dining_tables,
      new_path: new_dining_table_path, 
      headers: ["Área / Ambiente", "Código / Nombre", "Capacidad", "Estado Actual"] do |table| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full" style="background-color: <%= table.area&.color || '#CBD5E1' %>"></div>
          <div class="text-sm font-bold text-gray-900"><%= table.area&.name || "Sin área" %></div>
        </div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= table.code %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= table.capacity %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter
          <%= case table.status
              when 'free' then 'bg-green-100 text-green-700'
              when 'occupied' then 'bg-red-100 text-red-700'
              when 'reserved' then 'bg-yellow-100 text-yellow-700'
              end %>">
          <%= table.status.humanize %>
        </span>
      </td>
      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Editar", edit_dining_table_path(table), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
        </div>
      </td>
    </tr>
<% end %>
    <!-- Table List -->
    
  </div>
</div>
