<%= form_with(model: supplier, class: "block max-w-3xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8") do |form| %>
  <% if supplier.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2><%= pluralize(supplier.errors.count, "error") %> prohibited this supplier from being saved:</h2>

      <ul class="list-disc ml-6">
        <% supplier.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>



  <div class="mb-6">
    <%= form.label :name, "Nombre", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": supplier.errors[:name].none?, "ring-red-300 focus:ring-red-500": supplier.errors[:name].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :contact_name, "Nombre de contacto", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :contact_name, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": supplier.errors[:contact_name].none?, "ring-red-300 focus:ring-red-500": supplier.errors[:contact_name].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :contact_email, "Correo de contacto", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :contact_email, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": supplier.errors[:contact_email].none?, "ring-red-300 focus:ring-red-500": supplier.errors[:contact_email].any?}] %>
  </div>

  <div class="mb-6">
    <%= form.label :contact_phone, "Telefono de contacto", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.text_field :contact_phone, class: ["block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": supplier.errors[:contact_phone].none?, "ring-red-300 focus:ring-red-500": supplier.errors[:contact_phone].any?}] %>
  </div>

  <div class="mb-6 flex items-center gap-3">
    <%= form.label :is_active, "Activo", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
    <%= form.check_box :is_active, class: ["h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600", {"ring-gray-300 focus:ring-indigo-600": supplier.errors[:is_active].none?, "ring-red-300 focus:ring-red-500": supplier.errors[:is_active].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "Guardar", class: "flex w-full sm:w-auto justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
  </div>
<% end %>
