<% content_for :title, "Iniciar Sesión | MombaPOS Nicaragua" %>
<% content_for :noindex, true %>

<main class="w-full max-w-lg bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.06)] overflow-hidden border border-slate-100">
  <div class="p-8 sm:p-12">
    <!-- Header: Logo y Bienvenida -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center mb-3">
        <%= image_tag "logo-mombapos.png", 
                      alt: "MombaPOS Nicaragua - Facturación y Punto de Venta", 
                      class: "h-16 w-auto object-contain mx-auto transition-transform hover:scale-105 duration-200" %>
      </div>

      <h1 class="text-2xl font-black text-slate-900 tracking-tight">
        Acceso a Momba<span class="text-[var(--color-brand)]">POS</span>
      </h1>
      <p class="mt-2 text-sm text-slate-500">
        Ingresa tus credenciales para gestionar tus ventas y facturación.
      </p>
    </div>

    <!-- Formulario de Autenticación -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-5">
        <!-- Campo Correo -->
        <div>
          <%= f.label :email, "Correo electrónico", class: "block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5" %>
          <%= f.email_field :email, 
                            autofocus: true, 
                            autocomplete: "email",
                            required: true,
                            class: "appearance-none block w-full px-4 py-3.5 rounded-xl border border-slate-200 placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-[var(--color-brand)] transition-all duration-200 text-sm bg-slate-50/50 hover:bg-white",
                            placeholder: "usuario@empresa.com" %>
        </div>

        <!-- Campo Contraseña -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Contraseña", class: "block text-xs font-bold uppercase tracking-wider text-slate-700" %>
          </div>
          <div class="relative">
            <%= f.password_field :password, 
                                 id: "user_password_input",
                                 autocomplete: "current-password",
                                 required: true,
                                 class: "appearance-none block w-full px-4 py-3.5 pr-11 rounded-xl border border-slate-200 placeholder-slate-400 text-slate-900 focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-[var(--color-brand)] transition-all duration-200 text-sm bg-slate-50/50 hover:bg-white",
                                 placeholder: "••••••••" %>
            <!-- Botón mostrar / ocultar contraseña -->
            <button type="button" 
                    onclick="const pass = document.getElementById('user_password_input'); pass.type = pass.type === 'password' ? 'text' : 'password';" 
                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Recuperación de contraseña -->
        <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
          <div class="flex justify-end">
            <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-xs font-semibold text-slate-500 hover:text-[var(--color-brand)] transition-colors" %>
          </div>
        <% end %>

        <!-- Botón de Envío -->
        <div>
          <%= f.submit "Entrar al sistema",
              class: "w-full cursor-pointer flex justify-center py-3.5 px-4 rounded-xl text-white font-bold text-sm shadow-md bg-[var(--color-brand)] hover:opacity-95 active:scale-[0.99] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-orange-500 transition-all duration-200" %>
        </div>
      </div>
    <% end %>

    <!-- Enlaces institucionales y pie -->
    <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <span>© <%= Time.current.year %> MombaPOS</span>
      <div class="space-x-3 font-medium">
        <%= link_to "Términos", "/terms", class: "hover:text-slate-600 transition-colors" %>
        <%= link_to "Privacidad", "/privacy", class: "hover:text-slate-600 transition-colors" %>
        <%= link_to "Soporte", "/soporte", class: "hover:text-slate-600 transition-colors" %>
      </div>
    </div>
  </div>
</main>