<% content_for :title, "Perfil de Cliente | #{@customer.name}" %>

<div class="max-w-7xl mx-auto space-y-8 animate-fade-in">
  <% if notice.present? %>
    <div class="py-3 px-4 bg-green-50 border border-green-200 text-green-700 font-bold rounded-xl flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
      <%= notice %>
    </div>
  <% end %>

  <%# Header Section %>
  <div class="relative overflow-hidden bg-white rounded-3xl shadow-sm ring-1 ring-slate-200 p-6 md:p-8">
    <div class="absolute top-0 right-0 -m-8 w-64 h-64 bg-indigo-50 rounded-full opacity-50 blur-3xl -z-10"></div>
    
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-4xl font-black shadow-xl shadow-indigo-100 shrink-0">
        <%= @customer.name[0].upcase %>
      </div>
      
      <div class="flex-1 space-y-4 w-full">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h1 class="text-3xl font-black text-slate-900 tracking-tight"><%= @customer.name %></h1>
              <% if @customer.is_active? %>
                <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 text-[10px] font-black uppercase tracking-widest rounded-full">Activo</span>
              <% else %>
                <span class="px-2.5 py-1 bg-slate-100 text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-full">Inactivo</span>
              <% end %>
            </div>
            <p class="text-slate-500 font-medium flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.307-.066l.003-.001.006-.003a.73.73 0 00.111-.06c.054-.035.132-.086.234-.157.204-.141.503-.362.868-.654.73-.583 1.706-1.442 2.618-2.523C15.952 13.48 17 11.232 17 9a7 7 0 10-14 0c0 2.232 1.048 4.479 2.87 6.537.912 1.08 1.888 1.94 2.617 2.523.366.292.665.513.869.654.102.071.18.122.234.157a.73.73 0 00.111.06l.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
              </svg>
              <%= "#{@customer.municipality&.name}, #{@customer.department&.name}" %>
            </p>
          </div>
          
          <div class="flex gap-2">
            <%= link_to edit_customer_path(@customer), class: "p-3 bg-white border border-slate-200 rounded-xl text-slate-600 hover:bg-slate-50 transition-all shadow-sm" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
              </svg>
            <% end %>

            <%= button_to @customer, method: :delete, class: "p-3 bg-white border border-red-100 rounded-xl text-red-500 hover:bg-red-50 transition-all shadow-sm", data: { turbo_confirm: "¿Eliminar este cliente definitivamente?" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            <% end %>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="space-y-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Saldo Actual</span>
            <p class="text-xl font-black text-slate-900 leading-none">C$ 0.00</p>
          </div>
          <div class="space-y-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Límite de Crédito</span>
            <p class="text-xl font-black text-indigo-600 leading-none">C$ <%= number_with_precision(@customer.credit_limit, precision: 2) %></p>
          </div>
          <div class="space-y-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Total Compras</span>
            <p class="text-xl font-black text-slate-900 leading-none">C$ <%= number_with_precision(@customer.invoices.sum(:total_local_amount), precision: 2) %></p>
          </div>
          <div class="space-y-1">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Frecuencia</span>
            <p class="text-xl font-black text-slate-900 leading-none"><%= @customer.invoices.count %> Facturas</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <%# Left Column: Detailed Info %>
    <div class="lg:col-span-1 space-y-8">
      <div class="bg-white rounded-3xl shadow-sm ring-1 ring-slate-200 p-6 space-y-6">
        <h3 class="text-sm font-black text-slate-900 uppercase tracking-widest border-b border-slate-100 pb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-indigo-500">
            <path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z" />
          </svg>
          Información de Contacto
        </h3>
        
        <div class="space-y-5">
          <div>
            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Representante</span>
            <p class="text-sm font-bold text-slate-800"><%= @customer.contact_name %></p>
          </div>
          <div>
            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Correo</span>
            <p class="text-sm font-bold text-indigo-600 underline"><%= @customer.contact_email %></p>
          </div>
          <div>
            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Teléfono</span>
            <p class="text-sm font-bold text-slate-800"><%= @customer.contact_phone %></p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-50">
            <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Dirección</span>
            <p class="text-xs font-medium text-slate-600 leading-relaxed italic line-clamp-3">"<%= @customer.address %>"</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-3xl shadow-xl p-6 text-white relative overflow-hidden">
        <div class="absolute -bottom-8 -right-8 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
        <h3 class="text-[10px] font-black uppercase tracking-widest mb-4 opacity-60">Status Fiscal</h3>
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-bold opacity-60 mb-1 leading-none">Tipo de Cliente</p>
            <p class="text-lg font-black tracking-tight"><%= @customer.is_tax_exempt? ? "Exento de IVA" : "Aplica Impuestos" %></p>
          </div>
          <div class="p-2 bg-white/10 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
              <path d="M12.232 4.232a2.5 2.5 0 013.536 3.536l-1.225 1.224a.75.75 0 001.061 1.06l1.224-1.224a4 4 0 00-5.656-5.656l-3 3a4 4 0 00.225 5.865.75.75 0 00.977-1.138 2.5 2.5 0 01-.142-3.667l3-3z" />
              <path d="M11.603 7.963a.75.75 0 00-.977 1.138 2.5 2.5 0 01.142 3.667l-3 3a2.5 2.5 0 01-3.536-3.536l1.225-1.224a.75.75 0 00-1.061-1.06l-1.224 1.224a4 4 0 105.656 5.656l3-3a4 4 0 00-.225-5.865z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <%# Right Column: Purchase History %>
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-3xl shadow-sm ring-1 ring-slate-200 flex flex-col h-full min-h-[500px]">
        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/50 rounded-t-3xl">
          <div class="flex items-center gap-3">
            <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <h3 class="text-base font-black text-slate-800 tracking-tight">Historial de Compras</h3>
          </div>
          <span class="px-3 py-1 bg-white border border-slate-200 rounded-full text-[10px] font-black text-slate-500 uppercase tracking-widest shadow-sm">
            Últimos movimientos
          </span>
        </div>

        <div class="flex-1 overflow-auto">
          <% if @customer.invoices.any? %>
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-[10px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-50">
                  <th class="px-6 py-4">Factura #</th>
                  <th class="px-6 py-4">Fecha</th>
                  <th class="px-6 py-4">Tipo</th>
                  <th class="px-6 py-4">Monto</th>
                  <th class="px-6 py-4 text-right">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <% @customer.invoices.order(invoice_date: :desc).limit(10).each do |invoice| %>
                  <tr class="group hover:bg-slate-50/80 transition-all cursor-pointer" onclick="window.location='<%= invoice_path(invoice) %>'">
                    <td class="px-6 py-4">
                      <span class="font-black text-slate-900 group-hover:text-indigo-600 transition-colors"><%= invoice.invoice_number %></span>
                    </td>
                    <td class="px-6 py-4 text-xs font-bold text-slate-600">
                      <%= invoice.invoice_date.strftime("%d/%m/%Y") %>
                    </td>
                    <td class="px-6 py-4">
                      <% if invoice.invoice_type == 'cash' %>
                        <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[10px] font-black uppercase rounded-md">Contado</span>
                      <% else %>
                        <span class="px-2 py-0.5 bg-orange-50 text-orange-600 text-[10px] font-black uppercase rounded-md">Crédito</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 font-black text-slate-900">
                      C$ <%= number_with_precision(invoice.total_local_amount, precision: 2) %>
                    </td>
                    <td class="px-6 py-4 text-right">
                      <% case invoice.status %>
                      <% when 'issued', 'Emitida' %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 bg-green-50 text-green-700 text-[10px] font-black uppercase rounded-lg">
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                          <%= invoice.status %>
                        </span>
                      <% when 'draft', 'Borrador' %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 bg-slate-50 text-slate-600 text-[10px] font-black uppercase rounded-lg">
                          <%= invoice.status %>
                        </span>
                      <% when 'annulled', 'Anulada' %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 bg-red-50 text-red-600 text-[10px] font-black uppercase rounded-lg">
                          <%= invoice.status %>
                        </span>
                      <% else %>
                        <span class="inline-flex items-center gap-1.5 px-2 py-1 bg-gray-50 text-gray-600 text-[10px] font-black uppercase rounded-lg">
                          <%= invoice.status %>
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <div class="flex flex-col items-center justify-center h-full py-12 text-center">
              <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-200 mb-4 border border-slate-100">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m6 4.125 2.25 2.25m0 0 2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
                </svg>
              </div>
              <p class="text-sm font-bold text-slate-400">Este cliente aún no registra compras.</p>
              <%= link_to new_invoice_path(customer_id: @customer.id), class: "mt-4 px-4 py-2 bg-indigo-50 text-indigo-600 rounded-xl text-xs font-black uppercase tracking-widest hover:bg-indigo-100 transition-all border border-indigo-100" do %>
                + Crear Primera Factura
              <% end %>
            </div>
          <% end %>
        </div>
        
        <div class="p-6 border-t border-slate-100 bg-slate-50/30 rounded-b-3xl mt-auto">
          <%= link_to invoices_path(customer_id: @customer.id), class: "flex items-center justify-center gap-2 w-full py-4 bg-white border border-slate-200 rounded-2xl text-slate-600 text-xs font-black uppercase tracking-widest hover:border-indigo-400 hover:text-indigo-600 transition-all shadow-sm shadow-slate-100" do %>
            Ver Todas las Transacciones
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-4">
    <%= link_to customers_path, class: "flex items-center justify-center gap-2 px-10 py-4 bg-slate-100 text-slate-500 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-slate-200 transition-all border border-slate-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      Volver al Listado
    <% end %>
  </div>
</div>
