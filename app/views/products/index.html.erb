<% content_for :title, "Productos" %>

<%# Dashboard Indicators %>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6 print:hidden">
  
  <%# Card 1: Total de Productos %>
  <div class="bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
    <div class="w-12 h-12 rounded-[1.25rem] bg-orange-50 text-orange-600 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
      </svg>
    </div>
    <div>
      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total de Productos</span>
      <span class="block text-2xl font-black text-slate-900 mt-0.5"><%= @total_products %></span>
      <span class="text-[10px] text-slate-500 font-medium">Registrados en catálogo</span>
    </div>
  </div>

  <%# Card 2: Existencia Total %>
  <div class="bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
    <div class="w-12 h-12 rounded-[1.25rem] bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 20.25h12m-7.5-3v3m3-3v3m-10.125-3h17.25c.621 0 1.125-.504 1.125-1.125V4.875c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125z" />
      </svg>
    </div>
    <div>
      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Existencia Total</span>
      <span class="block text-2xl font-black text-slate-900 mt-0.5"><%= number_with_delimiter(@total_stock) %></span>
      <span class="text-[10px] text-slate-500 font-medium">Unidades físicas en stock</span>
    </div>
  </div>

  <%# Card 3: Valor de Venta %>
  <div class="bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
    <div class="w-12 h-12 rounded-[1.25rem] bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-1.971-.659-1.171-.88-1.171-2.303 0-3.182 1.171-.879 3.07-.879 4.242 0M12 6c-.725 0-1.45-.22-1.971-.659" />
      </svg>
    </div>
    <div>
      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Valor Inventario (Venta)</span>
      <span class="block text-xl font-black text-slate-900 mt-0.5"><%= number_to_currency @inventory_sale_value, unit: "C$", separator: ".", delimiter: "," %></span>
      <span class="text-[10px] text-slate-400 font-medium block">Cantidad x Precio Venta</span>
    </div>
  </div>

  <%# Card 4: Valor de Costo %>
  <div class="bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm flex items-center gap-4 hover:shadow-md transition-shadow">
    <div class="w-12 h-12 rounded-[1.25rem] bg-slate-100 text-slate-700 flex items-center justify-center shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 .621-.504 1.125-1.125 1.125H4.875c-.621 0-1.125-.504-1.125-1.125v-4.25m16.5 0a2.25 2.25 0 00-1.879-2.218A25.85 25.85 0 0012 11.25c-2.33 0-4.593.308-6.746.899a2.25 2.25 0 00-1.879 2.218m16.5 0a2.25 2.25 0 01-1.879 2.218A25.85 25.85 0 0112 17.25c-2.33 0-4.593-.308-6.746-.899a2.25 2.25 0 01-1.879-2.218M12 3v1.5m0 3v3m0-6a3.75 3.75 0 110 7.5 3.75 3.75 0 010-7.5z" />
      </svg>
    </div>
    <div>
      <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Valor Inventario (Costo)</span>
      <span class="block text-xl font-black text-slate-900 mt-0.5"><%= number_to_currency @inventory_cost_value, unit: "C$", separator: ".", delimiter: "," %></span>
      <span class="text-[10px] text-slate-400 font-medium block">Cantidad x Costo</span>
    </div>
  </div>

</div>

<%= render "shared/resource_table", 
      title: "Productos", 
      collection: @products,
      new_path: new_product_path, 
      headers: [["Codigo", "product_code"],["Categoria", "product_category"],  ["Nombre", "name"], ["Tipo", "product_type"], ["Cantidad", "quantity"],  ["Costo", "cost"],  ["Precio", "price"], "Composicion", "Acciones"] do |product| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= product.product_code %></div>
      </td>
       <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= product.product_category.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= product.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900">
          <span class="px-2 py-1 rounded text-xs font-bold <%= product.kit? ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-600' %>">
            <%= product.product_type_before_type_cast %>
          </span>
        </div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-semibold text-gray-900"><%= product.quantity %></div>
      </td>  
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-semibold text-gray-900"><%= number_to_currency product.cost,  unit: "C$",
            separator: ".",
            delimiter: ",",
            format: "%u %n" %>
        </div>
      </td>  
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-semibold text-gray-900"><%= number_to_currency product.price,  unit: "C$",
            separator: ".",
            delimiter: ",",
            format: "%u %n" %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap text-center">
        <% if product.kit? %>
          <%= link_to edit_product_product_composition_path(product), class: "inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-600 bg-orange-50 px-3 py-1.5 rounded-lg transition-all" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            Configurar
          <% end %>
        <% else %>
          <span class="text-xs text-slate-300 italic">No aplica</span>
        <% end %>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Mostrar", product, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Editar", edit_product_path(product), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", product, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar este producto?" } %>
        </div>
      </td>
    </tr>
<% end %>
