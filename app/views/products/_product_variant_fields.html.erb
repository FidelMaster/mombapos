<%# locals: (f:) %>
<% variant = f.object %>
<div class="p-4 md:p-5 bg-slate-50 rounded-2xl border border-slate-200 transition-all hover:border-orange-200 group" data-role="variant-row">
  <%= f.hidden_field :_destroy %>
  
  <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
    <!-- SKU -->
    <div class="md:col-span-2">
      <%= f.label :sku, "SKU / Código", class: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" %>
      <%= f.text_field :sku, placeholder: "VAR-001", class: "block w-full rounded-xl border-slate-200 bg-white text-slate-900 font-mono text-xs py-2 px-3 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 uppercase" %>
    </div>

    <!-- Nombre de Variante -->
    <div class="md:col-span-3">
      <%= f.label :variant_name, "Nombre / Descripción", class: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" %>
      <%= f.text_field :variant_name, placeholder: "Ej: Oro 14K Amarillo - Talla 7", class: "block w-full rounded-xl border-slate-200 bg-white text-slate-900 text-xs py-2 px-3 focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
    </div>

    <!-- Metal & Kilataje -->
    <div class="md:col-span-2">
      <%= f.label :metal_type, "Metal / Quilataje", class: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" %>
      <div class="grid grid-cols-2 gap-1">
        <%= f.text_field :metal_type, placeholder: "Oro", class: "block w-full rounded-xl border-slate-200 bg-white text-slate-900 text-xs py-2 px-2 focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
        <%= f.text_field :karat, placeholder: "14k", class: "block w-full rounded-xl border-slate-200 bg-white text-slate-900 text-xs py-2 px-2 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 uppercase" %>
      </div>
    </div>

    <!-- Talla -->
    <div class="md:col-span-1">
      <%= f.label :size, "Talla", class: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" %>
      <%= f.text_field :size, placeholder: "7", class: "block w-full rounded-xl border-slate-200 bg-white text-slate-900 text-xs py-2 px-2 text-center focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
    </div>

    <!-- Precio -->
    <div class="md:col-span-2">
      <%= f.label :price, "Precio (C$)", class: "block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1" %>
      <%= f.number_field :price, step: "0.01", placeholder: "0.00", class: "block w-full rounded-xl border-slate-200 bg-white text-orange-600 font-bold text-xs py-2 px-3 text-right focus:ring-2 focus:ring-orange-500 focus:border-orange-500" %>
    </div>

    <!-- Stock Disponible -->
    <div class="md:col-span-1">
      <%= f.label :stock_quantity, "Stock", class: "block text-[10px] font-black uppercase tracking-wider text-blue-700 mb-1" %>
      <%= f.number_field :stock_quantity, step: "1", min: "0", placeholder: "0", class: "block w-full rounded-xl border-blue-200 bg-blue-50/50 text-blue-900 font-bold text-xs py-2 px-2 text-center focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <!-- Acciones -->
    <div class="md:col-span-1 flex items-center justify-end gap-1">
      <label class="flex items-center gap-1 cursor-pointer" title="Variante activa">
        <%= f.check_box :is_active, class: "rounded border-slate-300 text-orange-600 focus:ring-orange-500 w-4 h-4" %>
      </label>
      <button type="button" data-action="product-form#removeVariant" class="p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors" title="Eliminar variante">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
      </button>
    </div>
  </div>
</div>
