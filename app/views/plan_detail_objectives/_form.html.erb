<%= form_with(model: plan_detail_objective, class: "contents") do |form| %>
  <% if plan_detail_objective.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(plan_detail_objective.errors.count, "error") %> prohibited this plan_detail_objective from being saved:</h2>

      <ul class="list-disc ml-6">
        <% plan_detail_objective.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :plan_detail_id %>
    <%= form.text_field :plan_detail_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": plan_detail_objective.errors[:plan_detail_id].none?, "border-red-400 focus:outline-red-600": plan_detail_objective.errors[:plan_detail_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": plan_detail_objective.errors[:description].none?, "border-red-400 focus:outline-red-600": plan_detail_objective.errors[:description].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :is_active %>
    <%= form.check_box :is_active, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": plan_detail_objective.errors[:is_active].none?, "border-red-400 focus:outline-red-600": plan_detail_objective.errors[:is_active].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
