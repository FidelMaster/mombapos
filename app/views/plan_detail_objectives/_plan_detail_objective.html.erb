<div id="<%= dom_id plan_detail_objective %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Plan detail:</strong>
    <%= plan_detail_objective.plan_detail_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= plan_detail_objective.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= plan_detail_objective.is_active? ? "Yes" : "No" %>
  </div>
</div>
