<div id="<%= dom_id menu_item %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Key:</strong>
    <%= menu_item.key %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Label:</strong>
    <%= menu_item.label %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Icon:</strong>
    <%= menu_item.icon %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Path:</strong>
    <%= menu_item.path %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= menu_item.section %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Position:</strong>
    <%= menu_item.position %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Item type:</strong>
    <%= menu_item.item_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Parent:</strong>
    <%= menu_item.parent_id %>
  </div>
</div>
