<% content_for :title, "Editar Lista de Precios" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar Lista de Precios</h1>

  <%= render "form", price_list: @price_list %>

  <%= link_to "Ver Lista de Precios", @price_list, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Volver a Listas de Precios", price_lists_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
