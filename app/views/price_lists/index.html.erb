<% content_for :title, "Listas de precios" %>

<%= render "shared/resource_table", 
      title: "Listas de precios", 
      collection: @price_lists,
      new_path: new_price_list_path, 
      headers: ["Nombre", "Moneda", "Activo"] do |price_list| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= price_list.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= price_list.currency %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= price_list.is_active? ? "Sí" : "No" %></div>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Ver", price_list, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Editar", edit_price_list_path(price_list), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", price_list, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro?" } %>
        </div>
      </td>
    </tr>
<% end %>
