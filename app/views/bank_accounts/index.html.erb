<% content_for :title, "Cuentas Bancarias" %>

<%= render "shared/resource_table", 
      title: "Cuentas Bancarias", 
      collection: @bank_accounts,
      new_path: new_bank_account_path, 
      headers: ["Banco", "Titular", "Número de Cuenta", "Moneda"] do |bank_account| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-medium text-gray-900"><%= bank_account.bank.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-700"><%= bank_account.account_name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-mono text-indigo-600 font-medium"><%= bank_account.account_number %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 uppercase">
        <%= bank_account.currency %>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Editar", edit_bank_account_path(bank_account), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", bank_account, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar esta cuenta?" } %>
        </div>
      </td>
    </tr>
<% end %>
