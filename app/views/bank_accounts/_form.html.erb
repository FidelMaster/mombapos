<%= form_with(model: bank_account, class: "block w-full bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8 max-w-2xl mx-auto") do |form| %>
  <% if bank_account.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100 mb-6">
      <h2 class="text-red-800 font-semibold"><%= pluralize(bank_account.errors.count, "error") %> prohibieron guardar esta cuenta:</h2>
      <ul class="list-disc ml-6 text-red-700 mt-2">
        <% bank_account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div>
      <%= form.label :bank_id, "Banco", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
      <%= form.collection_select :bank_id, @banks, :id, :name, { prompt: "Seleccione banco" }, class: "block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div>
      <%= form.label :account_name, "Titular de la Cuenta", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
      <%= form.text_field :account_name, placeholder: "Nombre del responsable", class: "block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :account_number, "Número de Cuenta", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.text_field :account_number, placeholder: "Ej. 123456789", class: "block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>

      <div>
        <%= form.label :currency, "Moneda", class: "block text-sm font-medium leading-6 text-gray-900 mb-2" %>
        <%= form.select :currency, ["NIO", "USD", "EUR"], { prompt: "Seleccione moneda" }, class: "block w-full rounded-lg border-0 px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>
    </div>

    <div class="pt-4 border-t flex gap-3">
      <%= form.submit "Guardar Cuenta", class: "flex-1 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer" %>
      <%= link_to "Cancelar", bank_accounts_path, class: "rounded-xl bg-white px-6 py-3 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  </div>
<% end %>
