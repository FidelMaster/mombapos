<%= form_with(model: plan_extra_control_detail, class: "contents") do |form| %>
  <% if plan_extra_control_detail.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(plan_extra_control_detail.errors.count, "error") %> prohibited this plan_extra_control_detail from being saved:</h2>

      <ul class="list-disc ml-6">
        <% plan_extra_control_detail.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :plan_extra_control_id %>
    <%= form.text_field :plan_extra_control_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": plan_extra_control_detail.errors[:plan_extra_control_id].none?, "border-red-400 focus:outline-red-600": plan_extra_control_detail.errors[:plan_extra_control_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :observation %>
    <%= form.text_area :observation, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": plan_extra_control_detail.errors[:observation].none?, "border-red-400 focus:outline-red-600": plan_extra_control_detail.errors[:observation].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
