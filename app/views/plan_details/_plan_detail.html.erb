<div id="<%= dom_id plan_detail %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Plan:</strong>
    <%= plan_detail.plan_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= plan_detail.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Duration in days:</strong>
    <%= plan_detail.duration_in_days %>
  </div>
</div>
