<% content_for :title, "Editar unidad de medida de stock" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar unidad de medida de stock</h1>

  <%= render "form", stock_unit_measure: @stock_unit_measure %>

  <%= link_to "Mostrar", @stock_unit_measure, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Regresar a Unidades de Medida de Stock", stock_unit_measures_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
