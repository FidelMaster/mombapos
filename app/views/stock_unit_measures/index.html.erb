<% content_for :title, "Unidades de medida de stock" %>

<%= render "shared/resource_table", 
      title: "Unidades de medida de stock", 
      collection: @stock_unit_measures,
      new_path: new_stock_unit_measure_path, 
      headers: ["Nombre", "Activo"] do |stock_unit_measure| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= stock_unit_measure.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= stock_unit_measure.is_active? ? "Sí" : "No" %></div>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Mostrar", stock_unit_measure, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Editar", edit_stock_unit_measure_path(stock_unit_measure), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Eliminar", stock_unit_measure, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar esta unidad de medida de stock?" } %>
        </div>
      </td>
    </tr>
<% end %>
