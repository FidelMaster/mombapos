<div class="space-y-6 animate-fade-in-down">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Historial de Movimientos</h1>
      <p class="text-slate-500 mt-1">Registro de entradas y salidas de inventario</p>
    </div>
    <%= link_to new_stock_movement_path, class: "bg-slate-900 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-xl shadow-lg shadow-indigo-100 transition-all flex items-center gap-2" do %>
       <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
         <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
       </svg>
       Nuevo Movimiento
    <% end %>
  </div>

  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50/50">
          <tr>
            <th class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">Fecha</th>
            <th class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">Producto</th>
            <th class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100">Almacén</th>
            <th class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100 text-center">Tipo</th>
            <th class="px-6 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border-b border-slate-100 text-right">Cantidad</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @movements.any? %>
            <% @movements.each do |movement| %>
              <tr class="group hover:bg-slate-50/50 transition-colors">
                <td class="px-6 py-4">
                  <span class="text-sm font-bold text-slate-600"><%= movement.created_at.strftime("%d/%m/%Y") %></span>
                  <span class="text-[10px] font-bold text-slate-400 block"><%= movement.created_at.strftime("%H:%M") %></span>
                </td>
                <td class="px-6 py-4">
                   <p class="text-sm font-bold text-slate-800"><%= movement.product&.name %></p>
                </td>
                 <td class="px-6 py-4 text-sm text-slate-600">
                   <%= movement.warehouse&.name %>
                 </td>
                 <td class="px-6 py-4 text-center">
                    <% if movement.movement_type == 'in' %>
                        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-1 text-xs font-bold text-emerald-600 ring-1 ring-inset ring-emerald-600/20">ENTRADA</span>
                    <% else %>
                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-bold text-red-600 ring-1 ring-inset ring-red-600/20">SALIDA</span>
                    <% end %>
                 </td>
                 <td class="px-6 py-4 text-right">
                    <span class="text-sm font-black <%= movement.movement_type == 'in' ? 'text-emerald-600' : 'text-red-500' %>">
                        <%= movement.movement_type == 'in' ? '+' : '-' %><%= movement.quantity %>
                    </span>
                 </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-10 text-center text-slate-400 italic font-medium">No hay movimientos registrados</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
