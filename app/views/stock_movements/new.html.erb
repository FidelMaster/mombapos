<div class="max-w-3xl mx-auto space-y-6 animate-fade-in-down">
  <div class="flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Nuevo Movimiento</h1>
        <p class="text-slate-500 mt-1">Registrar entrada o salida de inventario</p>
    </div>
    <%= link_to stock_movements_path, class: "text-sm font-bold text-slate-500 hover:text-slate-800" do %>
        Cancelar
    <% end %>
  </div>

  <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8">
    <%= form_with model: @stock_movement, class: "space-y-6" do |f| %>
      <% if @stock_movement.errors.any? %>
        <div class="p-4 bg-red-50 text-red-600 rounded-xl mb-6">
          <ul class="list-disc list-inside text-sm">
            <% @stock_movement.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <%= f.label :movement_type, "Tipo de Movimiento", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 px-1" %>
            <div class="flex items-center gap-4 bg-slate-50 p-2 rounded-2xl border border-slate-100">
                <label class="flex items-center gap-2 cursor-pointer px-4 py-2 rounded-xl transition-all hover:bg-white has-[:checked]:bg-white has-[:checked]:shadow-sm">
                    <%= f.radio_button :movement_type, "in", checked: true, class: "text-emerald-500 focus:ring-emerald-500" %>
                    <span class="text-sm font-bold text-slate-700">Entrada (IN)</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer px-4 py-2 rounded-xl transition-all hover:bg-white has-[:checked]:bg-white has-[:checked]:shadow-sm">
                     <%= f.radio_button :movement_type, "out", class: "text-red-500 focus:ring-red-500" %>
                    <span class="text-sm font-bold text-slate-700">Salida (OUT)</span>
                </label>
            </div>
        </div>

        <div>
           <%= f.label :warehouse_id, "Almacén", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 px-1" %>
           <%= f.collection_select :warehouse_id, @warehouses, :id, :name, {}, class: "block w-full rounded-2xl border-slate-100 bg-slate-50 py-3 px-4 text-slate-700 font-semibold focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500 transition-all" %>
        </div>
      </div>

      <div>
        <%= f.label :product_id, "Producto", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 px-1" %>
        <%= f.collection_select :product_id, @products, :id, :name, { prompt: "Seleccione un producto..." }, class: "block w-full rounded-2xl border-slate-100 bg-slate-50 py-3 px-4 text-slate-700 font-semibold focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500 transition-all", data: { controller: "select" } %>
      </div>

      <div>
         <%= f.label :quantity, "Cantidad", class: "block text-xs font-black text-slate-400 uppercase tracking-widest mb-2 px-1" %>
         <%= f.number_field :quantity, step: "0.01", min: "0", class: "block w-full rounded-2xl border-slate-100 bg-slate-50 py-3 px-4 text-slate-700 font-bold text-lg focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500 transition-all", placeholder: "0.00" %>
      </div>

      <div class="pt-6 border-t border-slate-100">
        <%= f.submit "Registrar Movimiento", class: "w-full py-4 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-2xl shadow-xl shadow-slate-200 transition-all transform hover:scale-[1.01] active:scale-[0.99] cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
