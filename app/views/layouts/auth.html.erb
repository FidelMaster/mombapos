<!DOCTYPE html>
<html>
  <head>
    <title>Billing SaaS</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 h-screen w-full flex items-center justify-center antialiased font-sans selection:bg-primary-100 selection:text-primary-700">
    <div class="w-full h-full flex items-center justify-center p-4">
      <div class="fixed top-4 right-4 z-50 space-y-2">
        <% flash.each do |key, value| %>
          <% 
            color_class = case key.to_s
              when 'notice' then 'bg-green-100 text-green-800 border-green-200'
              when 'alert', 'error' then 'bg-red-100 text-red-800 border-red-200'
              else 'bg-blue-100 text-blue-800 border-blue-200'
            end
          %>
          <div class="<%= color_class %> px-4 py-3 rounded-xl border shadow-sm text-sm font-medium flex items-center gap-2 animate-fade-in-down" role="alert">
            <%= value %>
          </div>
        <% end %>
      </div>
      <%= yield %>
    </div>
  </body>
</html>
