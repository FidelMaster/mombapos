<div class="min-h-screen bg-slate-50/50 p-6 md:p-10">
  <div class="max-w-6xl mx-auto space-y-8">
    
    <%# 1. BREADCRUMB & HEADER %>
    <div>
      <%= link_to tenants_path, class: "group inline-flex items-center gap-2 text-slate-500 hover:text-slate-900 font-bold text-sm mb-4 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Regresar a Lista de Tenants
      <% end %>

      <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 rounded-2xl border border-slate-200 bg-white flex items-center justify-center overflow-hidden shrink-0 shadow-sm p-1">
            <% if @tenant.logo.attached? %>
              <%= image_tag @tenant.logo, class: "w-full h-full object-contain" %>
            <% elsif @tenant.logo_url.present? %>
              <img src="<%= @tenant.logo_url %>" class="w-full h-full object-contain" onerror="this.style.display='none'">
            <% else %>
              <img src="/logo.jpg" class="w-full h-full object-contain grayscale" onerror="this.style.display='none'">
            <% end %>
          </div>

          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight"><%= @tenant.name %></h1>
              <span class="font-mono text-xs px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 font-bold">
                <%= @tenant.subdomain %>.mombapos.com
              </span>
            </div>
            <p class="text-slate-500 text-sm mt-1">
              Gestión de accesos, creación de credenciales y activación/inactivación de usuarios.
            </p>
          </div>
        </div>

        <%# Tenant Active Toggle Button %>
        <div class="flex items-center gap-3 shrink-0">
          <div class="text-right">
            <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Estado del Tenant</span>
            <span class="text-sm font-bold <%= @tenant.is_active? ? 'text-emerald-600' : 'text-rose-600' %>">
              <%= @tenant.is_active? ? 'Activo (Operativo)' : 'Inactivo (Suspendido)' %>
            </span>
          </div>

          <%= button_to toggle_active_tenant_path(@tenant), method: :patch, class: "inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl text-xs font-bold transition-all shadow-sm cursor-pointer #{@tenant.is_active? ? 'bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200'}" do %>
            <% if @tenant.is_active? %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
              </svg>
              Inactivar Tenant
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Activar Tenant
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# 2. MAIN GRID: NUEVO USUARIO (COL 1) + LISTA USUARIOS (COL 2) %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

      <%# FORMULARIO NUEVO USUARIO %>
      <div id="nuevo-usuario" class="lg:col-span-1 bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100">
        <div class="border-b border-slate-100 pb-4 mb-6">
          <h2 class="text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
            Crear Usuario
          </h2>
          <p class="text-xs text-slate-500 mt-1">Registra un nuevo usuario asignado a este tenant.</p>
        </div>

        <% if @new_user.errors.any? %>
          <div class="rounded-2xl bg-rose-50 p-4 border border-rose-100 mb-6">
            <h3 class="text-xs font-bold text-rose-800"><%= pluralize(@new_user.errors.count, "error") %> al crear usuario:</h3>
            <ul class="list-disc ml-5 text-xs text-rose-700 mt-1 space-y-0.5">
              <% @new_user.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with(model: @new_user, url: create_user_tenant_path(@tenant), method: :post, class: "space-y-4") do |f| %>
          <div>
            <%= f.label :email, "Correo Electrónico", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.email_field :email, placeholder: "usuario@#{@tenant.subdomain}.com", required: true, class: "block w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 shadow-xs" %>
          </div>

          <div>
            <%= f.label :password, "Contraseña", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password, placeholder: "Mínimo 6 caracteres", required: true, class: "block w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 shadow-xs" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmar Contraseña", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.password_field :password_confirmation, placeholder: "Repite la contraseña", required: true, class: "block w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 shadow-xs" %>
          </div>

          <div>
            <%= f.label :role_id, "Rol Asignado", class: "block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" %>
            <%= f.select :role_id, @roles.map { |r| [r.name.upcase, r.id] }, { prompt: "Seleccionar Rol..." }, required: true, class: "block w-full rounded-xl border border-slate-200 px-3.5 py-2.5 text-sm text-slate-900 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 shadow-xs" %>
          </div>

          <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100">
            <%= f.check_box :is_active, checked: true, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600 cursor-pointer" %>
            <%= f.label :is_active, "Activar usuario inmediatamente", class: "text-xs font-medium text-slate-700 cursor-pointer" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Guardar Usuario", class: "w-full py-3 px-4 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 transition-colors shadow-sm cursor-pointer active:scale-95" %>
          </div>
        <% end %>
      </div>

      <%# TABLA DE USUARIOS DEL TENANT %>
      <div class="lg:col-span-2 bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-6">
          <div>
            <h2 class="text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              Usuarios Registrados (<%= @users.count %>)
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Control de cuentas activas e inactivas.</p>
          </div>

          <div class="flex items-center gap-2 text-xs">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-bold border border-emerald-100">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <%= @users.count(&:is_active?) %> Activos
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-bold border border-slate-200">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span>
              <%= @users.count { |u| !u.is_active? } %> Inactivos
            </span>
          </div>
        </div>

        <% if @users.any? %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-slate-100 text-[10px] font-black uppercase tracking-wider text-slate-400">
                  <th class="pb-3 px-3">Usuario / Email</th>
                  <th class="pb-3 px-3">Rol</th>
                  <th class="pb-3 px-3">Estado</th>
                  <th class="pb-3 px-3 text-right">Acción / Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @users.each do |user| %>
                  <tr class="hover:bg-slate-50/60 transition-colors group">
                    <td class="py-3.5 px-3">
                      <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-700 flex items-center justify-center font-bold text-xs uppercase shrink-0">
                          <%= user.email.first(2) %>
                        </div>
                        <div>
                          <div class="text-sm font-bold text-slate-900"><%= user.email %></div>
                          <div class="text-[11px] text-slate-400">ID: <%= user.id %> • Creado <%= user.created_at.strftime("%d/%m/%Y") %></div>
                        </div>
                      </div>
                    </td>

                    <td class="py-3.5 px-3">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                        <%= user.app_role&.name&.upcase || user.role&.upcase || "SIN ROL" %>
                      </span>
                    </td>

                    <td class="py-3.5 px-3">
                      <% if user.is_active? %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                          Activo
                        </span>
                      <% else %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                          Inactivo
                        </span>
                      <% end %>
                    </td>

                    <td class="py-3.5 px-3 text-right">
                      <div class="flex items-center justify-end gap-2">
                        <%# Botón Activar / Inactivar %>
                        <%= button_to toggle_user_status_tenant_path(@tenant, user_id: user.id), 
                              method: :patch, 
                              class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer #{user.is_active? ? 'bg-amber-50 text-amber-800 hover:bg-amber-100 border border-amber-200' : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200'}",
                              title: user.is_active? ? "Desactivar acceso de este usuario" : "Permitir acceso de este usuario" do %>
                          <% if user.is_active? %>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                            Inactivar
                          <% else %>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Activar
                          <% end %>
                        <% end %>

                        <%# Botón Eliminar %>
                        <%= button_to destroy_user_tenant_path(@tenant, user_id: user.id), 
                              method: :delete, 
                              class: "p-1.5 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer", 
                              data: { turbo_confirm: "¿Estás seguro de eliminar al usuario #{user.email}?" }, 
                              title: "Eliminar usuario" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="py-12 text-center">
            <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-3xl flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-800">No hay usuarios registrados</h3>
            <p class="text-xs text-slate-400 mt-1">Utiliza el formulario de la izquierda para crear el primer usuario de este tenant.</p>
          </div>
        <% end %>
      </div>

    </div>

  </div>
</div>
