<%= form_with(model: tenant, class: "block max-w-4xl mx-auto bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 md:p-8 space-y-8", data: { controller: "tenant-form" }) do |form| %>
  <% if tenant.errors.any? %>
    <div id="error_explanation" class="rounded-xl bg-red-50 p-4 border border-red-100">
      <h2 class="text-sm font-semibold text-red-800 mb-2"><%= pluralize(tenant.errors.count, "error") %> impidieron guardar este tenant:</h2>
      <ul class="list-disc ml-6 text-sm text-red-700 space-y-1">
        <% tenant.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# SECCIÓN 1: DATOS GENERALES %>
  <div>
    <div class="border-b border-gray-100 pb-3 mb-6">
      <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
        </svg>
        Información General de la Empresa
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Identificación básica y acceso del tenant en la plataforma.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= form.label :name, "Nombre de la Empresa / Negocio", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :name, placeholder: "Ej. Joyería & Variedades Momba", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:name].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:name].any?}] %>
      </div>

      <div>
        <%= form.label :subdomain, "Subdominio", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <div class="relative rounded-xl shadow-sm">
          <%= form.text_field :subdomain, placeholder: "mi-negocio", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:subdomain].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:subdomain].any?}] %>
        </div>
      </div>

      <div>
        <%= form.label :email, "Correo Electrónico de Contacto", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.email_field :email, placeholder: "admin@negocio.com", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:email].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:email].any?}] %>
      </div>

      <div>
        <%= form.label :license_id, "Licencia Asignada", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.collection_select :license_id, License.all, :id, :name, { prompt: "Seleccione una licencia..." }, class: "block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>

      <div>
        <%= form.label :uuid, "Identificador UUID (Opcional)", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :uuid, placeholder: "Generado automáticamente si se deja vacío", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:uuid].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:uuid].any?}] %>
      </div>
    </div>
  </div>

  <%# SECCIÓN 2: UBICACIÓN Y CONTACTO (FACTURACIÓN) %>
  <div>
    <div class="border-b border-gray-100 pb-3 mb-6">
      <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Ubicación y Contacto (Encabezado de Tickets y Facturas)
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Estos datos se reflejan en el membrete de facturas y tickets impresos para tus clientes.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="md:col-span-2">
        <%= form.label :business_dni, "Cédula / RUC", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :business_dni, placeholder: "Ej. 1234567890123", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:business_dni].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:business_dni].any?}] %>
      </div>

      <div class="md:col-span-2">
        <%= form.label :address, "Dirección Física", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :address, placeholder: "Ej. Costado Este de Catedral 2c al Norte", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:address].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:address].any?}] %>
      </div>

      <div>
        <%= form.label :city, "Ciudad / Municipio", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :city, placeholder: "Ej. Granada, Managua, etc.", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:city].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:city].any?}] %>
      </div>

      <div>
        <%= form.label :phone, "Teléfono / WhatsApp", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.telephone_field :phone, placeholder: "Ej. +505 8888-8888 / 2552-0000", class: ["block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset placeholder:text-gray-400 focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6", {"ring-gray-300 focus:ring-indigo-600": tenant.errors[:phone].none?, "ring-red-300 focus:ring-red-500": tenant.errors[:phone].any?}] %>
      </div>
    </div>
  </div>

  <%# SECCIÓN 3: LOGO DEL TENANT %>
  <div>
    <div class="border-b border-gray-100 pb-3 mb-6">
      <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Logo de la Empresa
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Sube el logo que aparecerá en los tickets de venta, facturas impresas y documentos.</p>
    </div>

    <div class="p-5 bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
      <div class="flex flex-col sm:flex-row items-center gap-6">
        <%# Previsualización del Logo %>
        <div class="relative w-28 h-28 shrink-0 rounded-2xl border-2 border-dashed border-slate-300 bg-white flex items-center justify-center overflow-hidden shadow-inner group">
          <% has_logo = tenant.logo.attached? || tenant.logo_url.present? %>
          <% current_logo_src = tenant.logo.attached? ? url_for(tenant.logo) : (tenant.logo_url.presence || "") %>
          
          <img src="<%= current_logo_src %>" 
               class="w-full h-full object-contain p-2 <%= has_logo ? '' : 'hidden' %>" 
               data-tenant-form-target="imagePreview" 
               alt="Logo de <%= tenant.name.presence || 'la empresa' %>" 
               onerror="this.classList.add('hidden'); document.getElementById('tenant-logo-placeholder')?.classList.remove('hidden')">
          
          <div id="tenant-logo-placeholder" class="flex flex-col items-center text-slate-400 p-2 <%= has_logo ? 'hidden' : '' %>" data-tenant-form-target="imagePlaceholder">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-slate-400 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-[10px] font-bold uppercase text-slate-400">Sin logo</span>
          </div>
        </div>

        <div class="flex-1 space-y-3 text-center sm:text-left">
          <p class="text-xs text-slate-600">
            Carga una imagen en formato PNG o JPG (fondo transparente o blanco recomendado). Tamaño óptimo: 300x300px o rectangular.
          </p>
          <div>
            <%= form.file_field :logo, 
                  accept: "image/png,image/jpeg,image/webp,image/jpg", 
                  class: "block w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer", 
                  data: { action: "change->tenant-form#previewLogo" } %>
          </div>

          <div class="pt-1">
            <label class="block text-[11px] font-medium text-slate-500 mb-1">O especifica una URL externa del Logo:</label>
            <%= form.text_field :logo_url, placeholder: "https://ejemplo.com/logo.png", class: "block w-full rounded-xl border-0 px-3 py-1.5 text-xs text-gray-900 shadow-sm ring-1 ring-inset ring-gray-200 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# SECCIÓN 4: PARÁMETROS DEL PLAN Y LÍMITES %>
  <div>
    <div class="border-b border-gray-100 pb-3 mb-6">
      <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
        </svg>
        Límites y Preferencias
      </h3>
      <p class="text-xs text-gray-500 mt-0.5">Control de capacidades del plan y configuración regional.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div>
        <%= form.label :max_users, "Máx Usuarios", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= form.number_field :max_users, class: "block w-full rounded-xl border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :max_branches, "Máx Sucursales", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= form.number_field :max_branches, class: "block w-full rounded-xl border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :max_products, "Máx Productos", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= form.number_field :max_products, class: "block w-full rounded-xl border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :max_invoices, "Máx Facturas", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= form.number_field :max_invoices, class: "block w-full rounded-xl border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :default_currency, "Moneda por Defecto", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.select :default_currency, Tenant.default_currencies.keys, {}, class: "block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>

      <div>
        <%= form.label :timezone, "Zona Horaria", class: "block text-sm font-medium leading-6 text-gray-900 mb-1.5" %>
        <%= form.text_field :timezone, placeholder: "America/Managua", class: "block w-full rounded-xl border-0 px-3.5 py-2.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      </div>
    </div>

    <div class="mt-6 flex items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200/60">
      <%= form.check_box :is_active, class: "h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600 cursor-pointer" %>
      <%= form.label :is_active, "Tenant Activo (Permite acceso de usuarios y facturación)", class: "text-sm font-medium text-gray-900 cursor-pointer" %>
    </div>
  </div>

  <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
    <%= link_to "Cancelar", tenants_path, class: "rounded-xl px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 transition-colors" %>
    <%= form.submit "Guardar Tenant", class: "flex justify-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer transition-colors" %>
  </div>
<% end %>
