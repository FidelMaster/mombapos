<div id="<%= dom_id tenant %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Uuid:</strong>
    <%= tenant.uuid %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= tenant.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Subdomain:</strong>
    <%= tenant.subdomain %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Logo url:</strong>
    <%= tenant.logo_url %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max users:</strong>
    <%= tenant.max_users %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max invoices:</strong>
    <%= tenant.max_invoices %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max branches:</strong>
    <%= tenant.max_branches %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Max products:</strong>
    <%= tenant.max_products %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Default currency:</strong>
    <%= tenant.default_currency %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Timezone:</strong>
    <%= tenant.timezone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= tenant.is_active? ? "Yes" : "No" %>
  </div>
</div>
