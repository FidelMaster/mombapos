<% content_for :title, "Tenants" %>

<%= render "shared/resource_table", 
      title: "Tenants", 
      collection: @tenants,
      new_path: new_tenant_path, 
      headers: ["Uuid", "Name", "Subdomain", "Logo url", "Email", "Módulos"] do |tenant| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# Dynamic fields %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= tenant.uuid %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= tenant.name %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= tenant.subdomain %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= tenant.logo_url %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm text-gray-900"><%= tenant.email %></div>
      </td>
      <td class="px-6 py-4 whitespace-nowrap">
        <%= link_to manage_modules_tenant_path(tenant), class: "inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-bold hover:bg-green-100 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
          </svg>
          Configurar Módulos
        <% end %>
      </td>

      <%# Actions %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Show", tenant, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Edit", edit_tenant_path(tenant), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Delete", tenant, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      </td>
    </tr>
<% end %>
