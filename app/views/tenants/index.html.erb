<% content_for :title, "Tenants" %>

<%= render "shared/resource_table", 
      title: "Tenants", 
      collection: @tenants,
      new_path: new_tenant_path, 
      headers: ["Logo", "Empresa", "Subdominio", "Ciudad / Tel", "Estado", "Usuarios", "Módulos", "Acciones"] do |tenant| %>

    <tr class="hover:bg-slate-50 transition-colors duration-200 group">
      <%# 1. Logo %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="w-10 h-10 rounded-xl border border-slate-200 bg-white flex items-center justify-center overflow-hidden shrink-0 shadow-xs">
          <% if tenant.logo.attached? %>
            <%= image_tag tenant.logo, class: "w-full h-full object-contain p-0.5" %>
          <% elsif tenant.logo_url.present? %>
            <img src="<%= tenant.logo_url %>" class="w-full h-full object-contain p-0.5" onerror="this.style.display='none'">
          <% else %>
            <img src="/logo.jpg" class="w-full h-full object-contain p-0.5 grayscale" onerror="this.style.display='none'">
          <% end %>
        </div>
      </td>

      <%# 2. Nombre y UUID %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="text-sm font-semibold text-gray-900"><%= tenant.name %></div>
        <div class="text-xs text-gray-400 font-mono"><%= tenant.uuid %></div>
      </td>

      <%# 3. Subdominio %>
      <td class="px-6 py-4 whitespace-nowrap">
        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-mono font-medium bg-slate-100 text-slate-700">
          <%= tenant.subdomain %>
        </span>
      </td>

      <%# 4. Ubicación y Contacto %>
      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
        <div><%= tenant.city.presence || "—" %></div>
        <div class="text-xs text-gray-400"><%= tenant.phone.presence || "" %></div>
      </td>

      <%# 5. Estado del Tenant (Activar / Inactivar con 1 clic) %>
      <td class="px-6 py-4 whitespace-nowrap">
        <%= button_to toggle_active_tenant_path(tenant), 
              method: :patch, 
              class: "group/status inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer #{tenant.is_active? ? 'bg-emerald-50 text-emerald-700 hover:bg-rose-50 hover:text-rose-700 border border-emerald-200 hover:border-rose-200' : 'bg-rose-50 text-rose-700 hover:bg-emerald-50 hover:text-emerald-700 border border-rose-200 hover:border-emerald-200'}", 
              title: (tenant.is_active? ? "Clic para inactivar este tenant" : "Clic para activar este tenant") do %>
          <span class="w-2 h-2 rounded-full <%= tenant.is_active? ? 'bg-emerald-500 group-hover/status:bg-rose-500' : 'bg-rose-500 group-hover/status:bg-emerald-500' %>"></span>
          <span class="group-hover/status:hidden"><%= tenant.is_active? ? 'Activo' : 'Inactivo' %></span>
          <span class="hidden group-hover/status:inline"><%= tenant.is_active? ? 'Inactivar' : 'Activar' %></span>
        <% end %>
      </td>

      <%# 6. Columna Usuarios (Crear y Gestionar) %>
      <td class="px-6 py-4 whitespace-nowrap">
        <div class="flex items-center gap-2">
          <% user_count = tenant.users.size %>
          <% active_count = tenant.users.count { |u| u.is_active? } %>

          <%= link_to manage_users_tenant_path(tenant), 
                class: "inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-xl text-xs font-bold transition-colors border border-indigo-100 group/btn",
                title: "Ver y administrar usuarios de #{tenant.name}" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-indigo-500 group-hover/btn:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span><%= user_count %> <%= user_count == 1 ? 'Usuario' : 'Usuarios' %></span>
            <% if user_count > 0 %>
              <span class="text-[10px] px-1.5 py-0.2 rounded-full <%= active_count == user_count ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                <%= active_count %> act
              </span>
            <% end %>
          <% end %>

          <%= link_to manage_users_tenant_path(tenant, anchor: "nuevo-usuario"), 
                class: "inline-flex items-center justify-center w-7 h-7 bg-slate-100 text-slate-600 hover:bg-indigo-600 hover:text-white rounded-lg text-xs font-bold transition-all shadow-2xs", 
                title: "Crear nuevo usuario para #{tenant.name}" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
          <% end %>
        </div>
      </td>

      <%# 7. Módulos %>
      <td class="px-6 py-4 whitespace-nowrap">
        <%= link_to manage_modules_tenant_path(tenant), class: "inline-flex items-center gap-2 px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-bold hover:bg-green-100 transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
          </svg>
          Configurar Módulos
        <% end %>
      </td>

      <%# 8. Acciones %>
      <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <%= link_to "Show", tenant, class: "text-indigo-600 hover:text-indigo-900 bg-indigo-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= link_to "Edit", edit_tenant_path(tenant), class: "text-amber-600 hover:text-amber-900 bg-amber-50 px-3 py-1 rounded-full text-xs font-semibold" %>
          <%= button_to "Delete", tenant, method: :delete, class: "text-red-600 hover:text-red-900 bg-red-50 px-3 py-1 rounded-full text-xs font-semibold cursor-pointer", data: { turbo_confirm: "¿Estás seguro de eliminar el tenant #{tenant.name}?" } %>
        </div>
      </td>
    </tr>
<% end %>
