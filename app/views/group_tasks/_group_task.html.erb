<div id="<%= dom_id group_task %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Group:</strong>
    <%= group_task.group_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= group_task.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= group_task.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Observation:</strong>
    <%= group_task.observation %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= group_task.start_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">End date:</strong>
    <%= group_task.end_date %>
  </div>
</div>
