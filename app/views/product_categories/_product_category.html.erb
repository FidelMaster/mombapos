<div id="<%= dom_id product_category %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Tenant:</strong>
    <%= product_category.tenant_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= product_category.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= product_category.is_active? ? "Yes" : "No" %>
  </div>
</div>
