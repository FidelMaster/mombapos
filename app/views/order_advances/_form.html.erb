<%# locals: (order:, order_advance:, payment_methods:, bank_accounts:, open: false) %>
<div id="advance_form">
  <%= form_with model: order_advance, url: order_order_advances_path(order), id: "new-advance-form",
        class: "space-y-5",
        data: { controller: "advance-form",
                advance_form_balance_value: order.balance_amount.to_f,
                advance_form_currency_value: order_currency_symbol } do |f| %>

    <% if order_advance.errors.any? %>
      <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4" role="alert">
        <ul class="list-inside list-disc space-y-1 text-sm font-medium text-rose-700">
          <% order_advance.errors.full_messages.uniq.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Monto -->
    <div>
      <div class="mb-1.5 flex items-center justify-between">
        <%= f.label :amount, "Monto del abono", class: "text-[11px] font-black uppercase tracking-wider text-slate-400" %>
        <button type="button" data-action="advance-form#fillBalance" id="advance-fill-balance"
                class="rounded-full bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-700 ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100">
          Liquidar saldo · <%= order_money(order.balance_amount) %>
        </button>
      </div>
      <div class="relative">
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg font-black text-slate-300"><%= order_currency_symbol %></span>
        <%= f.number_field :amount, step: "0.01", min: "0.01", max: order.balance_amount.to_f, required: true, autofocus: true,
              id: "advance-amount",
              class: "w-full rounded-2xl border-slate-200 py-4 pl-14 pr-4 text-right text-2xl font-black text-slate-900 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200",
              data: { advance_form_target: "amount", action: "input->advance-form#amountChanged" } %>
      </div>
      <p class="mt-1.5 min-h-[1rem]" data-advance-form-target="preview"></p>
    </div>

    <!-- Método de pago -->
    <fieldset>
      <legend class="mb-1.5 text-[11px] font-black uppercase tracking-wider text-slate-400">Método de pago</legend>
      <div class="grid grid-cols-3 gap-2">
        <% payment_methods.each_with_index do |pm, index| %>
          <label class="cursor-pointer">
            <%= f.radio_button :payment_method_id, pm.id,
                  checked: order_advance.payment_method_id ? order_advance.payment_method_id == pm.id : index.zero?,
                  class: "peer sr-only",
                  data: { advance_form_target: "method", action: "advance-form#methodChanged",
                          requires_bank: OrderAdvance::BANK_PAYMENT_CODES.include?(pm.code).to_s } %>
            <span class="flex h-full flex-col items-center justify-center gap-1 rounded-2xl border-2 border-slate-200 px-2 py-3 text-center text-xs font-bold text-slate-600 transition peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-800 hover:border-slate-300">
              <span class="text-lg"><%= { "CASH" => "💵", "TRANSFER" => "🏦", "POS" => "💳" }.fetch(pm.code, "💠") %></span>
              <%= pm.name %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <!-- Cuenta bancaria (solo transferencias) -->
    <div data-advance-form-target="bankSection" class="hidden">
      <%= f.label :bank_account_id, "Cuenta destino", class: "mb-1.5 block text-[11px] font-black uppercase tracking-wider text-slate-400" %>
      <%= f.collection_select :bank_account_id, bank_accounts, :id, :full_name, { include_blank: "Selecciona la cuenta…" },
            id: "advance-bank-account",
            class: "w-full rounded-2xl border-slate-200 py-2.5 text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200",
            data: { advance_form_target: "bankSelect" } %>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :reference_number, "N° de referencia / recibo", class: "mb-1.5 block text-[11px] font-black uppercase tracking-wider text-slate-400" %>
        <%= f.text_field :reference_number, id: "advance-reference", placeholder: "Ej: TRX-889102",
              class: "w-full rounded-2xl border-slate-200 py-2.5 text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200" %>
      </div>
      <div>
        <%= f.label :payment_date, "Fecha y hora del pago", class: "mb-1.5 block text-[11px] font-black uppercase tracking-wider text-slate-400" %>
        <%= f.datetime_local_field :payment_date, id: "advance-payment-date", required: true,
              value: (order_advance.payment_date || Time.current).strftime("%Y-%m-%dT%H:%M"),
              class: "w-full rounded-2xl border-slate-200 py-2.5 text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200" %>
      </div>
      <div>
        <%= f.label :exchange_rate, "Tipo de cambio", class: "mb-1.5 block text-[11px] font-black uppercase tracking-wider text-slate-400" %>
        <%= f.number_field :exchange_rate, step: "0.0001", min: "0.0001", id: "advance-exchange-rate",
              class: "w-full rounded-2xl border-slate-200 py-2.5 text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.label :notes, "Notas", class: "mb-1.5 block text-[11px] font-black uppercase tracking-wider text-slate-400" %>
        <%= f.text_area :notes, rows: 2, id: "advance-notes", placeholder: "Opcional",
              class: "w-full rounded-2xl border-slate-200 text-sm focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200" %>
      </div>
    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
      <button type="button" data-action="modal#close"
              class="rounded-2xl px-5 py-3 text-sm font-bold text-slate-500 hover:bg-slate-50 hover:text-slate-800">Cancelar</button>
      <%= f.button type: "submit", id: "advance-submit",
            data: { turbo_submits_with: "Registrando…" },
            class: "cursor-pointer rounded-2xl bg-emerald-600 px-6 py-3 text-sm font-black text-white shadow-lg shadow-emerald-600/20 transition hover:bg-emerald-700 active:scale-[0.98] disabled:opacity-60" do %>
        Registrar abono
      <% end %>
    </div>
  <% end %>
</div>
