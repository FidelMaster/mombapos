<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8"
       aria-label="Navegación principal">

    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <%= image_tag "logo-mombapos.png",
          alt: "MombaPOS",
          class: "h-9 w-auto object-contain" %>
    <% end %>

    <div class="flex items-center gap-3 sm:gap-5">
      <%= link_to "Inicio", root_path,
          class: "hidden text-sm font-medium text-slate-600 hover:text-orange-600 sm:block" %>

      <%= link_to "Iniciar sesión", new_user_session_path,
          class: "text-sm font-semibold text-slate-700 hover:text-orange-600" %>

      <%= link_to "Solicitar demo", root_path(anchor: "contacto"),
          class: "rounded-lg bg-orange-600 px-3.5 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-700 sm:px-4" %>
    </div>
  </nav>
</header>