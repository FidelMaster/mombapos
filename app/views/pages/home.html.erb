<!-- Navbar -->
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 sm:px-8" aria-label="Navegación principal">
    
    <!-- Logo + Texto de Marca -->
    <%= link_to root_path, class: "flex items-center gap-3 group" do %>
      <%= image_tag "logo-mombapos.png",
          alt: "MombaPOS",
          class: "h-9 w-auto object-contain transition group-hover:scale-105" %>
      <span class="text-xl font-black tracking-tight text-slate-900">
        Momba<span class="text-orange-600">POS</span>
      </span>
    <% end %>

    <!-- Menú central -->
    <div class="hidden items-center gap-8 md:flex">
      <%= link_to "Funcionalidades", "#funcionalidades",
          class: "text-sm font-medium text-slate-600 hover:text-orange-600 transition" %>
      <%= link_to "Cómo funciona", "#como-funciona",
          class: "text-sm font-medium text-slate-600 hover:text-orange-600 transition" %>
    </div>

    <!-- Acciones -->
    <div class="flex items-center gap-4">
      <%= link_to "Iniciar sesión", new_user_session_path,
          class: "hidden text-sm font-semibold text-slate-700 hover:text-orange-600 transition sm:block" %>

      <%= link_to "Solicitar demo", "#contacto",
          class: "rounded-xl bg-orange-600 px-4 py-2.5 text-sm font-bold text-white shadow-md shadow-orange-600/20 transition hover:bg-orange-700 active:scale-95" %>
    </div>
  </nav>
</header>

<main>
  <!-- Hero Section con fondo sutil -->
  <section class="relative overflow-hidden bg-gradient-to-b from-orange-50/40 via-white to-white py-16 sm:py-24">
    <!-- Patrón de cuadrícula de fondo -->
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-60"></div>

    <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 sm:px-8 lg:grid-cols-12 lg:gap-16">

      <!-- Columna Izquierda: Mensaje Comercial -->
      <div class="max-w-xl lg:col-span-7">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-orange-200/80 bg-orange-50 px-3.5 py-1.5 text-xs font-bold text-orange-700 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-orange-500"></span>
          </span>
          Gestión empresarial y punto de venta en Nicaragua
        </div>

        <h1 class="text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
          Tu negocio bajo control.
          <span class="text-orange-600 block sm:inline">Cada decisión informada.</span>
        </h1>

        <p class="mt-6 text-base leading-relaxed text-slate-600 sm:text-lg">
          Gestiona facturación multimoneda (C$ y US$), gestion de pedidos, inventario y cuentas por cobrar desde un solo lugar. Simple, confiable y accesible desde cualquier dispositivo.
        </p>

        <div class="mt-8 flex flex-col gap-3.5 sm:flex-row sm:items-center">
          <%= link_to "#contacto",
              class: "inline-flex items-center justify-center rounded-xl bg-orange-600 px-6 py-3.5 font-bold text-white shadow-lg shadow-orange-600/25 transition hover:bg-orange-700 active:scale-95" do %>
            Solicitar una demostración
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          <% end %>

          <%= link_to "#funcionalidades",
              class: "inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 font-bold text-slate-800 shadow-sm transition hover:bg-slate-50 active:scale-95" do %>
            Explorar módulos
          <% end %>
        </div>

        <!-- Indicadores de confianza -->
        <div class="mt-10 border-t border-slate-200/80 pt-6 flex flex-wrap items-center gap-6 text-xs font-semibold text-slate-500">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Impresión térmica (80mm)
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Cuentas por cobrar
          </div>
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            Multi-sucursal
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Vista realista del Sistema -->
      <div class="relative mx-auto w-full max-w-xl lg:col-span-5 lg:max-w-none">
        <!-- Resplandor exterior -->
        <div class="absolute -inset-2 rounded-3xl bg-gradient-to-tr from-orange-400 to-amber-200 opacity-20 blur-xl"></div>

        <div class="relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white shadow-2xl shadow-slate-900/10">
          
          <!-- Barra superior estilo aplicación -->
          <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/70 px-5 py-3.5">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-rose-400"></div>
              <div class="h-3 w-3 rounded-full bg-amber-400"></div>
              <div class="h-3 w-3 rounded-full bg-emerald-400"></div>
              <span class="ml-2 text-xs font-bold text-slate-700">MombaPOS • Panel Central</span>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100/70 px-2.5 py-0.5 text-xs font-bold text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              En vivo
            </span>
          </div>

          <!-- Métricas simuladas -->
          <div class="grid grid-cols-2 gap-3 p-4 sm:gap-4 sm:p-5">
            
            <!-- Tarjeta 1: Ventas Hoy -->
            <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
              <p class="text-xs font-semibold text-slate-500">Facturación del día</p>
              <p class="mt-1 text-xl font-black text-slate-900">C$ 24,850.00</p>
              <div class="mt-2.5 flex items-center gap-1.5 text-xs font-medium text-emerald-600">
                <span>↑ 14.2%</span>
                <span class="text-slate-400 font-normal">vs. ayer</span>
              </div>
            </div>

            <!-- Tarjeta 2: Por Cobrar -->
            <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
              <p class="text-xs font-semibold text-slate-500">Cuentas por cobrar</p>
              <p class="mt-1 text-xl font-black text-slate-900">$ 1,420.00</p>
              <div class="mt-2.5 flex items-center gap-1.5 text-xs font-medium text-amber-600">
                <span>3 pendientes</span>
                <span class="text-slate-400 font-normal">al corte</span>
              </div>
            </div>

            <!-- Gráfico de Ventas -->
            <div class="col-span-2 rounded-xl border border-slate-100 bg-white p-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Flujo de caja</p>
                  <p class="text-sm font-bold text-slate-900">Actividad mensual</p>
                </div>
                <span class="text-xs font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded">Octubre 2026</span>
              </div>

              <!-- Barras simuladas -->
              <div class="mt-5 flex h-28 items-end gap-2">
                <% [35, 50, 42, 68, 55, 82, 60, 95, 75, 88, 62, 100].each_with_index do |height, i| %>
                  <div class="flex-1 flex flex-col items-center gap-1 group">
                    <div class="w-full rounded-t-sm transition-all duration-300 <%= i == 11 ? 'bg-orange-600' : 'bg-orange-200 group-hover:bg-orange-400' %>"
                         style="height: <%= height %>%"></div>
                  </div>
                <% end %>
              </div>
              <div class="mt-2 flex justify-between text-[11px] font-medium text-slate-400">
                <span>Semana 1</span>
                <span>Semana 2</span>
                <span>Semana 3</span>
                <span>Cierre</span>
              </div>
            </div>

            <!-- Lista de Accesos Rápidos -->
            <div class="col-span-2 rounded-xl border border-slate-100 bg-slate-50/50 p-4">
              <p class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5">Accesos Operativos</p>
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs py-1.5 px-2 bg-white rounded-lg border border-slate-100">
                  <span class="font-semibold text-slate-700">Punto de Venta (Caja rápida)</span>
                  <span class="font-bold text-orange-600">Abrir →</span>
                </div>
                <div class="flex items-center justify-between text-xs py-1.5 px-2 bg-white rounded-lg border border-slate-100">
                  <span class="font-semibold text-slate-700">Cotizaciones & Pedidos</span>
                  <span class="font-bold text-orange-600">Ver 12 →</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Sección de Funcionalidades -->
  <section id="funcionalidades" class="scroll-mt-20 border-t border-slate-100 bg-slate-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-black uppercase tracking-widest text-orange-600">Módulos Integrados</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
          Todo lo necesario para operar sin fricción.
        </h2>
        <p class="mt-3 text-slate-600">
          Diseñado para negocios que necesitan rapidez en mostrador y claridad contable al final del día.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% [
          {
            num: "01",
            title: "Facturación & POS",
            desc: "Cobros en caja ágiles, soporte para impresoras térmicas de 80mm, multi-moneda (C$/$) y retenciones automáticas."
          },
          {
            num: "02",
            title: "Cuentas por Cobrar",
            desc: "Control de clientes con crédito, recibos oficiales de caja, abonos parciales y estado de cuenta al día."
          },
          {
            num: "03",
            title: "Cotizaciones & Pedidos",
            desc: "Genera propuestas comerciales en PDF descargables e imprenta, conviértelas en facturas con un solo clic."
          },
          {
            num: "04",
            title: "Control de Inventario",
            desc: "Kardex en tiempo real, múltiples bodegas, avisos de stock mínimo y composición de combos o recetas."
          },
          {
            num: "05",
            title: "Reportes Gerenciales",
            desc: "Cierres de caja X/Z, utilidad por producto, impacto de formas de pago y resumen de ventas por sucursal."
          },
          {
            num: "06",
            title: "Multi-inquilino y Roles",
            desc: "Permisos granulares por usuario (cajero, supervisor, admin) y arquitectura lista para múltiples sucursales."
          }
        ].each do |f| %>
          <article class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-orange-200 hover:shadow-md">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-orange-50 text-xs font-black text-orange-600">
              <%= f[:num] %>
            </span>
            <h3 class="mt-4 text-lg font-bold text-slate-900"><%= f[:title] %></h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= f[:desc] %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section id="como-funciona" class="scroll-mt-20 bg-white py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
      <div class="max-w-xl">
        <p class="text-xs font-black uppercase tracking-widest text-orange-600">Simplicidad en la nube</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
          Menos registros manuales. Más control de tu empresa.
        </h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Olvídate de hojas de cálculo desincronizadas o notas en papel. MombaPOS mantiene todas las áreas de tu negocio conectadas en una sola plataforma.
        </p>
      </div>

      <div class="space-y-4">
        <% [
          ["1", "Registra tus transacciones", "Abre turno en caja, registra ventas al contado o crédito y emite recibos."],
          ["2", "Controla cobros e inventario", "Rastrea el stock restante en bodega y cobra los saldos pendientes a clientes."],
          ["3", "Toma decisiones con reportes", "Consulta en tiempo real cuánto vendiste y qué productos generan mayor margen."]
        ].each do |step, title, desc| %>
          <div class="flex gap-4 rounded-2xl border border-slate-100 bg-slate-50/60 p-5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-xs font-black text-white">
              <%= step %>
            </span>
            <div>
              <h3 class="font-bold text-slate-900 text-sm"><%= title %></h3>
              <p class="mt-1 text-xs leading-relaxed text-slate-600"><%= desc %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Llamado a la acción (CTA) -->
  <section id="contacto" class="scroll-mt-20 bg-slate-950 px-5 py-16 sm:px-8 sm:py-20">
    <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
          Lleva tu administración al siguiente nivel.
        </h2>
        <p class="mt-3 leading-relaxed text-slate-300 text-sm sm:text-base">
          Solicita una demostración guiada sin compromiso y comprueba cómo MombaPOS se adapta a las operaciones diarias de tu empresa en Nicaragua.
        </p>
      </div>

      <%= link_to "https://wa.me/50585817060?text=Hola%2C%20deseo%20una%20demostraci%C3%B3n%20de%20MombaPOS",
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex shrink-0 items-center justify-center rounded-xl bg-orange-600 px-7 py-4 font-bold text-white shadow-xl shadow-orange-600/30 transition hover:bg-orange-700 active:scale-95 text-sm" do %>
        Contactar por WhatsApp →
      <% end %>
    </div>
  </section>
</main>

<!-- Footer -->
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-8 sm:px-8 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-2">
      <span class="text-sm font-black text-slate-900">Momba<span class="text-orange-600">POS</span></span>
      <span class="text-slate-300">|</span>
      <p class="text-xs text-slate-500">Gestión empresarial en Nicaragua.</p>
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs font-semibold text-slate-500">
      <%= link_to "Términos de servicio", terms_path, class: "hover:text-orange-600 transition" %>
      <%= link_to "Privacidad", privacy_path, class: "hover:text-orange-600 transition" %>
      <%= link_to "Soporte", support_path, class: "hover:text-orange-600 transition" %>
    </div>

    <p class="text-xs text-slate-400">
      © <%= Time.current.year %> MombaPOS · Managua, Nicaragua
    </p>
  </div>
</footer>