<div class="space-y-8 animate-fade-in-down" data-controller="dashboard">
  <!-- Header Section with Filter -->
  <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 pb-6 border-b border-slate-100">
    <div>
      <h1 class="text-4xl font-black text-slate-900 tracking-tighter">Panel de Control</h1>
      <p class="text-slate-500 mt-1 font-medium">Consumo del día y estado del inventario</p>
    </div>
    
    <div class="flex flex-wrap items-center gap-4">
      <%= form_with url: authenticated_root_path, method: :get, class: "flex items-center gap-3 bg-white p-2 rounded-2xl border border-slate-100 shadow-sm" do |f| %>
        <div class="flex items-center gap-2 px-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
          </svg>
          <%= f.date_field :date_from, value: params[:date_from] || Date.current, class: "border-none bg-transparent text-sm font-bold text-slate-700 focus:ring-0 p-0" %>
          <span class="text-slate-300 font-bold">al</span>
          <%= f.date_field :date_to, value: params[:date_to] || Date.current, class: "border-none bg-transparent text-sm font-bold text-slate-700 focus:ring-0 p-0" %>
        </div>
        <%= f.submit "Filtrar", class: "px-6 py-2 bg-slate-900 text-white rounded-xl font-black text-xs hover:bg-slate-800 transition-all cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# Main Stats Grid %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    <%# Daily Sales KPI %>
    <div class="bg-indigo-600 rounded-[2.5rem] p-8 text-white shadow-xl shadow-indigo-100 group relative overflow-hidden">
      <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full group-hover:scale-125 transition-transform"></div>
      <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-200 mb-4">Ventas del Período</p>
      <h3 class="text-4xl font-black tracking-tighter"><%= number_to_currency(@daily_revenue) %></h3>
      <div class="mt-8 flex items-center gap-2">
        <span class="w-10 h-1 h-1 bg-white/30 rounded-full overflow-hidden">
          <span class="block h-full bg-white w-2/3"></span>
        </span>
        <span class="text-[10px] font-black uppercase text-indigo-100"><%= @daily_invoices.count %> facturas emitidas</span>
      </div>
    </div>

    <%# Total Sales KPI %>
    <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm group">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-400 mb-4 px-1">Ingresos Históricos</p>
      <h3 class="text-3xl font-black text-slate-900 tracking-tighter"><%= number_to_currency(@total_revenue) %></h3>
      <div class="mt-8 flex items-center gap-1 text-emerald-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd" />
        </svg>
        <span class="text-[10px] font-bold">Creciendo sostenidamente</span>
      </div>
    </div>

    <%# Products Count KPI %>
    <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-slate-400 mb-4 px-1">Catálogo Activo</p>
      <h3 class="text-3xl font-black text-slate-900 tracking-tighter"><%= @total_products %></h3>
      <p class="mt-8 text-[10px] font-bold text-slate-400">Productos y servicios registrados</p>
    </div>

    <%# Low Stock KPI %>
    <div class="bg-red-50 rounded-[2.5rem] p-8 border border-red-100 group">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-red-500/60 mb-4 px-1">Stock Crítico</p>
      <h3 class="text-3xl font-black text-red-600 tracking-tighter"><%= @low_stock_products.count %></h3>
      <p class="mt-8 text-[10px] font-black text-red-600 uppercase tracking-widest">Requieren atención</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-10">
    <%# Payment Summary Section %>
    <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-10 overflow-hidden flex flex-col">
      <div class="flex items-center gap-4 mb-10">
        <div class="p-3 bg-emerald-50 text-emerald-600 rounded-2xl shadow-inner shadow-emerald-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h2 class="text-2xl font-black text-slate-800 tracking-tight">Recaudación</h2>
          <p class="text-sm font-medium text-slate-400">Métodos del día</p>
        </div>
      </div>

      <div class="space-y-4">
        <% if @payment_methods_summary.any? %>
          <% @payment_methods_summary.each do |payment| %>
            <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 border border-slate-100">
              <div>
                <p class="text-sm font-black text-slate-700 leading-tight"><%= payment.method_name %></p>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"><%= payment.currency %></span>
              </div>
              <div class="text-right">
                <p class="text-sm font-black text-slate-900">
                  <%= payment.currency == 'NIO' ? 'C$' : '$' %> <%= number_with_precision(payment.total_amount, precision: 2) %>
                </p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="py-10 text-center bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
            <p class="text-slate-400 font-bold italic">Sin movimientos</p>
          </div>
        <% end %>
      </div>
      <div class="mt-auto pt-6">
        <%= link_to reports_payment_methods_path, class: "flex items-center justify-center gap-2 w-full py-3 bg-slate-900 text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-slate-800 transition-all shadow-lg shadow-slate-200" do %>
          Ver Reporte Detallado
        <% end %>
      </div>
    </section>

    <%# Top Products Section %>
    <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-10 overflow-hidden flex flex-col">
      <div class="flex items-center gap-4 mb-10">
        <div class="p-3 bg-amber-50 text-amber-600 rounded-2xl shadow-inner shadow-amber-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
        <div>
          <h2 class="text-2xl font-black text-slate-800 tracking-tight">Más Vendidos</h2>
          <p class="text-sm font-medium text-slate-400">Productos con mayor rotación</p>
        </div>
      </div>

      <div class="space-y-6">
        <% if @top_products.any? %>
          <% @top_products.each_with_index do |item, idx| %>
            <% product = Product.find_by(id: item.product_id) %>
            <div class="flex items-center gap-6 group">
              <span class="text-3xl font-black text-slate-100 group-hover:text-amber-100 transition-colors w-10">0<%= idx + 1 %></span>
              <div class="flex-1">
                <p class="text-base font-black text-slate-700 leading-tight"><%= product&.name || "Producto no encontrado" %></p>
                <p class="text-xs font-bold text-slate-400 mt-0.5"><%= product&.product_category&.name %></p>
              </div>
              <div class="text-right">
                <p class="text-base font-black text-slate-900"><%= item.total_qty %></p>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">unidades</p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="py-10 text-center bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
            <p class="text-slate-400 font-bold italic">No hay datos de ventas aún</p>
          </div>
        <% end %>
      </div>
    </section>

    <%# Low Stock Table Section %>
    <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-10 overflow-hidden flex flex-col">
      <div class="flex items-center gap-4 mb-10">
        <div class="p-3 bg-red-50 text-red-600 rounded-2xl shadow-inner shadow-red-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <h2 class="text-2xl font-black text-slate-800 tracking-tight">Stock Crítico</h2>
          <p class="text-sm font-medium text-slate-400">Productos por debajo del mínimo</p>
        </div>
      </div>

      <div class="space-y-6">
        <% if @low_stock_products.any? %>
          <% @low_stock_products.each do |product| %>
            <div class="flex items-center justify-between p-4 rounded-2xl border border-slate-50 hover:bg-red-50/50 hover:border-red-100 transition-all">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-xl bg-white border border-slate-100 flex items-center justify-center text-slate-900 font-bold text-xs shadow-sm">
                   <%= product.name.first(2).upcase %>
                </div>
                <div>
                  <p class="text-sm font-black text-slate-700 leading-tight"><%= product.name %></p>
                  <p class="text-[10px] font-bold text-red-400 mt-0.5 uppercase tracking-widest">Bajo Stock</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-sm font-black text-red-600"><%= product.warehouse_stocks.first&.stock_available %></p>
                <p class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Disponible</p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="py-10 text-center bg-emerald-50 rounded-3xl border-2 border-dashed border-emerald-100">
            <p class="text-emerald-700 font-bold text-sm">Inventario en buen estado</p>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <%# Recent Invoices Table (Compact) %>
  <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden mt-10">
    <div class="p-8 border-b border-slate-50 flex items-center justify-between">
        <h2 class="text-2xl font-black text-slate-800 tracking-tight">Ventas Recientes</h2>
        <%= link_to invoices_path, class: "px-6 py-2 bg-slate-50 hover:bg-slate-100 text-slate-600 rounded-xl font-black text-xs transition-all" do %>
            VER TODAS
        <% end %>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50/50">
          <tr>
            <th class="px-10 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Comprobante</th>
            <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest">Cliente</th>
            <th class="px-8 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-right">Total</th>
            <th class="px-10 py-5 text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% if @recent_invoices.any? %>
            <% @recent_invoices.each do |invoice| %>
              <tr class="hover:bg-slate-50/30 transition-colors group">
                <td class="px-10 py-6">
                  <span class="text-sm font-black text-slate-900">#<%= invoice.invoice_number || invoice.id %></span>
                  <span class="block text-[10px] font-bold text-slate-400 uppercase mt-1"><%= invoice.invoice_date&.strftime("%d %b, %Y") %></span>
                </td>
                <td class="px-8 py-6">
                  <span class="text-sm font-bold text-slate-700 block"><%= invoice.customer_name_snapshot || invoice.customer&.name %></span>
                </td>
                <td class="px-8 py-6 text-sm font-black text-slate-900 text-right"><%= number_to_currency(invoice.total_local_amount) %></td>
                <td class="px-10 py-6 text-center">
                  <% if invoice.issued? %>
                    <span class="inline-flex items-center rounded-lg bg-emerald-50 px-3 py-1 text-[10px] font-black text-emerald-600 ring-1 ring-inset ring-emerald-600/20 uppercase tracking-widest">Emitida</span>
                  <% elsif invoice.draft? %>
                    <span class="inline-flex items-center rounded-lg bg-slate-50 px-3 py-1 text-[10px] font-black text-slate-600 ring-1 ring-inset ring-slate-600/20 uppercase tracking-widest">Borrador</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-lg bg-red-50 px-3 py-1 text-[10px] font-black text-red-600 ring-1 ring-inset ring-red-600/20 uppercase tracking-widest">Anulada</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
    .animate-spin-slow {
        animation: spin 3s linear infinite;
    }
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
    }
</style>
