<div class="space-y-8 animate-fade-in-down">
  <!-- Header Section -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Académico</h1>
      <p class="text-slate-500 mt-1">Gestión de cursos, planes y estudiantes.</p>
    </div>
    <div class="flex items-center gap-3">
        <%= link_to root_path, class: "px-4 py-2 bg-white border border-slate-200 rounded-xl shadow-sm text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors" do %>
            Volver a Ventas
        <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
     <!-- KPI Cards -->
     <div class="grid grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-20 h-20 bg-purple-50 rounded-full group-hover:scale-110 transition-transform"></div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest px-1">Estudiantes</p>
            <h3 class="text-3xl font-black text-slate-900 mt-2"><%= @total_students %></h3>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-20 h-20 bg-emerald-50 rounded-full group-hover:scale-110 transition-transform"></div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest px-1">Planes Activos</p>
            <h3 class="text-3xl font-black text-slate-900 mt-2"><%= @active_plans %></h3>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm relative overflow-hidden group col-span-2">
            <div class="absolute -right-4 -top-4 w-32 h-32 bg-indigo-50 rounded-full group-hover:scale-110 transition-transform"></div>
            <p class="text-sm font-bold text-slate-400 uppercase tracking-widest px-1">Grupos en Marcha</p>
            <h3 class="text-3xl font-black text-slate-900 mt-2"><%= @active_groups %></h3>
        </div>
     </div>

     <!-- Recent Plans List -->
    <section class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden flex flex-col">
        <div class="p-8 border-b border-slate-50 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="p-3 bg-purple-50 text-purple-600 rounded-2xl shadow-inner">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18c-2.305 0-4.408.867-6 2.292m0-14.25v14.25" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-xl font-black text-slate-800 tracking-tight">Planes Recientes</h2>
                    <p class="text-xs text-slate-400 font-medium">Últimas matriculaciones</p>
                </div>
            </div>
            <%= link_to plans_path, class: "text-xs font-black text-purple-600 hover:bg-purple-50 px-4 py-2 rounded-xl transition-all" do %>
                VER TODOS
            <% end %>
        </div>
        <div class="p-8 flex-1 custom-scrollbar overflow-y-auto max-h-[400px]">
            <div class="space-y-4">
                <% if @recent_plans.any? %>
                    <% @recent_plans.each do |plan| %>
                        <div class="flex items-center gap-4 p-4 rounded-2xl border border-slate-50 hover:border-purple-100 hover:bg-purple-50/20 transition-all group">
                            <div class="w-12 h-12 rounded-2xl bg-purple-100 flex items-center justify-center text-purple-600 font-black shadow-inner group-hover:scale-110 transition-transform">
                                <%= plan.name.first(2).upcase %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-base font-bold text-slate-700 truncate"><%= plan.name %></p>
                                <p class="text-xs font-medium text-slate-400 truncate tracking-wide"><%= plan.student&.name %></p>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-black text-slate-300 block uppercase tracking-tighter mb-1"><%= time_ago_in_words(plan.created_at) %></span>
                                <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-black text-emerald-600 ring-1 ring-inset ring-emerald-600/10">ACTIVO</span>
                            </div>
                        </div>
                    <% end %>
                <% else %>
                    <div class="py-12 text-center">
                        <p class="text-slate-300 font-bold italic">No hay planes registrados recientemente</p>
                    </div>
                <% end %>
            </div>
        </div>
    </section>
  </div>
</div>
