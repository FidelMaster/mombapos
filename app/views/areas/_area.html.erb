<div id="<%= dom_id area %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= area.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Is active:</strong>
    <%= area.is_active? ? "Yes" : "No" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Color:</strong>
    <%= area.color %>
  </div>
</div>
