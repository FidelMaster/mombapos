<aside 
  data-sidebar-target="sidebar"
  class="fixed top-0 left-0 z-30 h-screen w-64 flex flex-col bg-white border-r border-slate-200 transition-transform duration-300 transform -translate-x-full md:translate-x-0 shadow-md">

  <!-- Logo Section -->
  <div class="flex items-center justify-between px-6 h-16 border-b border-slate-100 shrink-0">
    <div class="flex items-center gap-3">
      <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-brand)] text-white shadow-lg shadow-orange-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </div>
      <span class="text-lg font-bold text-slate-900 tracking-wide">Momba<span class="text-[var(--color-brand)]">POS</span></span>
    </div>
    
    <!-- Close Button (Mobile) -->
    <button data-action="click->sidebar#close" class="md:hidden p-1 text-slate-400 hover:text-slate-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-2 py-4 space-y-4">

    <!-- ================= ⚡ OPERACIONES RÁPIDAS ================= -->
    <div>
      <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        ⚡ Operaciones rápidas
      </div>

         <%= link_to authenticated_root_path, class: nav_class(authenticated_root_path) do %>
        🏦 Panel de Control
      <% end %>

     <%= link_to invoices_path, class: nav_class(invoices_path) do %>
        📄 Facturas
      <% end %>
      <%= link_to new_invoice_path, class: nav_class(new_invoice_path) do %>
        📄 Factura Rapida
      <% end %>
    </div>

    <!-- ================= 🏪 OPERACIÓN ================= -->
    <div>
      <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        🏪 Operación
      </div>

      <%= link_to products_path, class: nav_class(products_path) do %>
        🍔 Menú / Productos
      <% end %>

      <%= link_to stock_warehouses_path, class: nav_class(stock_warehouses_path) do %>
        📦 Control Existencias
      <% end %>
      <% if current_user.admin? || current_user.owner? %>
      
        <%= link_to stock_movements_path, class: nav_class(stock_movements_path) do %>
          📦 Mantenimiento Inventario
        <% end %> 
      <% end %>

      <%= link_to customers_path, class: nav_class(customers_path) do %>
        👥 Clientes
      <% end %>

      <%= link_to branches_path, class: nav_class(branches_path) do %>
        🏪 Sucursales
      <% end %>
    </div>

    <!-- ================= 📊 CONTROL ================= -->
    <% if current_user.admin? || current_user.owner? %>
    <div>
      <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        📊 Control
      </div>

      <%= link_to reports_sales_summary_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors #{current_page?(reports_sales_summary_path) ? 'bg-[var(--color-brand)] text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-[var(--color-brand)]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0h.5m-1.5 0h-10m0 0h-.5" />
        </svg>
        Cierre de Ventas
      <% end %>

      <%= link_to reports_payment_methods_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors #{current_page?(reports_payment_methods_path) ? 'bg-[var(--color-brand)] text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-[var(--color-brand)]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
        </svg>
        Medios de Pago
      <% end %>

      <%= link_to reports_inventory_impact_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors #{current_page?(reports_inventory_impact_path) ? 'bg-[var(--color-brand)] text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-[var(--color-brand)]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.5 4.5L21.75 7.5" />
        </svg>
        Ventas por Producto
      <% end %>

      <%= link_to reports_kardex_path, class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors #{current_page?(reports_kardex_path) ? 'bg-[var(--color-brand)] text-white' : 'text-slate-600 hover:bg-slate-50 hover:text-[var(--color-brand)]'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
        Kardex de Inventario
      <% end %>
    </div>
    <% end %>

    <!-- ================= 📚 CATÁLOGOS GENERALES ================= -->
    <% if current_user.admin? || current_user.owner? %>
    <div>
      <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        📚 Catálogos generales
      </div>

      <%= link_to suppliers_path, class: nav_class(suppliers_path) do %>
        🚚 Proveedores
      <% end %>

      <%= link_to unit_measures_path, class: nav_class(unit_measures_path) do %>
        📏 Unidades de medida
      <% end %>

      <%= link_to price_list_items_path, class: nav_class(price_list_items_path) do %>
        💲 Listas de precios
      <% end %>

      <!-- <%= link_to banks_path, class: nav_class(banks_path) do %>
        🏦 Bancos
      <% end %>-->

      <%= link_to bank_accounts_path, class: nav_class(bank_accounts_path) do %>
        🏦 Cuentas Bancarias
      <% end %>

      <%= link_to product_categories_path, class: nav_class(product_categories_path) do %>
        🧩 Categorías
      <% end %>
    </div>
    <% end %>

    <!-- ================= 🧑‍💼 SISTEMA ================= -->
    <% if current_user.admin? || current_user.owner? %>
    <div>
      <div class="px-3 mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">
        🧑‍💼 Sistema
      </div>

      <%= link_to users_path, class: nav_class(users_path) do %>
        👥 Usuarios
      <% end %>

      <%= link_to roles_path, class: nav_class(roles_path) do %>
        🔑 Roles y Permisos
      <% end %>
    </div>
    <% end %>

  </nav>

  <!-- User Profile & Sign Out Section -->
  <div class="p-4 border-t border-slate-100 bg-slate-50/50 shrink-0">
    <div class="flex items-center justify-between gap-2">
      <div class="min-w-0">
        <div class="text-xs font-bold text-slate-800 truncate"><%= current_user.email %></div>
        <div class="text-[10px] text-slate-400 capitalize font-semibold mt-0.5"><%= current_user.app_role&.name || "Usuario" %></div>
      </div>
      <%= button_to destroy_user_session_path, method: :delete, class: "p-2 text-slate-400 hover:text-red-600 rounded-lg hover:bg-red-50/50 transition-colors cursor-pointer", title: "Cerrar sesión" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
        </svg>
      <% end %>
    </div>
  </div>
</aside>