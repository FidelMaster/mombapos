<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden" data-controller="table-interactions">
  <!-- Top Bar: Title, Search & Actions -->
  <div class="p-6 md:p-8 flex flex-col gap-6 bg-slate-50/30">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6">
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight"><%= title %></h1>
        <p class="text-sm font-medium text-slate-500 mt-1">Gestión de <%= title.downcase %> de tu sistema.</p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 flex-wrap">
        <% if local_assigns[:export_path] %>
          <%= link_to local_assigns[:export_path], class: "px-4 py-3 bg-emerald-600 text-white font-bold rounded-2xl hover:bg-emerald-700 transition-all active:scale-95 shadow-lg shadow-emerald-200 flex items-center justify-center gap-2 text-sm shrink-0" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            <span>Exportar</span>
          <% end %>
        <% end %>

        <% if local_assigns[:new_path] %>
          <%= link_to local_assigns[:new_path], class: "px-6 py-3 bg-slate-900 text-white font-black rounded-2xl hover:bg-slate-800 transition-all active:scale-95 shadow-lg shadow-slate-200 flex items-center justify-center gap-2 text-sm shrink-0" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            <span>Nuevo <%= title.singularize %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Search & Filters Section -->
    <%= form_with url: request.path, method: :get, class: "flex flex-col gap-4", data: { table_interactions_target: "form" } do |f| %>
      <div class="flex items-center gap-4 flex-wrap">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[240px]">
          <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-slate-400 group-focus-within:text-slate-900 transition-colors" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
          </div>
          <%= f.text_field :q, value: params[:q], placeholder: "Buscar por SKU, nombre, número...", class: "block w-full rounded-2xl border-slate-200 bg-white py-3 pl-11 pr-4 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all shadow-sm", data: { action: "input->table-interactions#submit" } %>
        </div>

        <!-- Per Page Selector -->
        <div class="flex items-center gap-2">
          <label for="per_page" class="text-sm font-semibold text-slate-600">Mostrar:</label>
          <%= f.select :per_page, [10, 25, 50, 100], { selected: params[:per_page] || 25 }, class: "py-3 px-4 rounded-2xl border border-slate-200 text-sm font-medium text-slate-700 focus:ring-2 focus:ring-slate-900 focus:border-slate-900 transition-all shadow-sm", data: { action: "change->table-interactions#change" } %>
        </div>
      </div>

      <!-- Dynamic Filter Slots -->
      <% if local_assigns[:filter_slot] %>
        <div class="flex items-center gap-3 flex-wrap p-4 bg-white rounded-xl border border-slate-200">
          <%= local_assigns[:filter_slot] %>
        </div>
      <% end %>

      <!-- Hidden Fields for Persistence -->
      <%= f.hidden_field :sort, value: params[:sort] %>
      <%= f.hidden_field :direction, value: params[:direction] %>
    <% end %>
  </div>

  <!-- Notification Banner -->
  <% if notice.present? %>
    <div class="px-6 pb-4 md:px-8">
      <div class="rounded-2xl bg-emerald-50 p-4 border border-emerald-100 flex items-center gap-3 animate-fade-in-down">
        <div class="p-1.5 bg-emerald-100 rounded-lg text-emerald-600">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <p class="text-sm font-bold text-emerald-800 tracking-tight"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <!-- Table Body -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-50/50 border-y border-slate-100">
          <% headers.each do |header| %>
            <th class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] whitespace-nowrap">
              <% if header.is_a?(Array) %>
                <%= sort_link(header[1], header[0]) %>
              <% else %>
                <%= header %>
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-50">
        <% if collection.any? %>
          <% collection.each do |item| %>
            <%= yield(item) %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="<%= headers.length %>" class="px-6 py-32 text-center">
              <div class="flex flex-col items-center gap-6">
                <div class="w-20 h-20 rounded-[2rem] bg-slate-50 flex items-center justify-center text-slate-200">
                   <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-black text-slate-900 tracking-tight">No hay resultados</h3>
                  <p class="text-sm text-slate-400 font-medium mt-1">No encontramos registros que coincidan con tu búsqueda.</p>
                </div>
                <%= link_to request.path, class: "text-xs font-black text-slate-900 uppercase tracking-widest hover:text-orange-600 transition-colors" do %>
                  Limpiar filtros
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Pagination Footer -->
  <% if local_assigns[:pagy] %>
    <div class="px-6 py-4 md:px-8 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between flex-wrap gap-4">
      <div class="text-sm text-slate-600 font-medium">
        Mostrando <span class="font-bold text-slate-900"><%= pagy.from %></span> a 
        <span class="font-bold text-slate-900"><%= pagy.to %></span> de 
        <span class="font-bold text-slate-900"><%= pagy.count %></span> registros
      </div>

      <nav class="flex items-center gap-2" aria-label="Pagination">
        <% if pagy.prev %>
          <%= link_to "← Anterior", { page: pagy.prev, q: params[:q], per_page: params[:per_page], sort: params[:sort], direction: params[:direction] }, class: "px-4 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors" %>
        <% else %>
          <span class="px-4 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-400 cursor-not-allowed">← Anterior</span>
        <% end %>

        <div class="flex items-center gap-1">
          <% (1..pagy.pages).each do |page_num| %>
            <% if page_num == pagy.page %>
              <span class="px-3 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold"><%= page_num %></span>
            <% elsif (pagy.page - 2..pagy.page + 2).include?(page_num) || page_num == 1 || page_num == pagy.pages %>
              <%= link_to page_num, { page: page_num, q: params[:q], per_page: params[:per_page], sort: params[:sort], direction: params[:direction] }, class: "px-3 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors" %>
            <% elsif page_num == 2 && pagy.page > 4 || page_num == pagy.pages - 1 && pagy.page < pagy.pages - 3 %>
              <span class="px-2 text-slate-400">...</span>
            <% end %>
          <% end %>
        </div>

        <% if pagy.next %>
          <%= link_to "Siguiente →", { page: pagy.next, q: params[:q], per_page: params[:per_page], sort: params[:sort], direction: params[:direction] }, class: "px-4 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-100 transition-colors" %>
        <% else %>
          <span class="px-4 py-2 rounded-lg border border-slate-200 text-sm font-semibold text-slate-400 cursor-not-allowed">Siguiente →</span>
        <% end %>
      </nav>
    </div>
  <% end %>
</div>