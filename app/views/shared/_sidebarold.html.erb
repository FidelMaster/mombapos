<aside data-sidebar-target="sidebar" class="fixed top-0 left-0 z-30 h-screen w-64 flex flex-col bg-white border-r border-slate-200 transition-transform duration-300 transform -translate-x-full md:translate-x-0 shadow-2xl md:shadow-none">
  <!-- Logo Section -->
  <div class="flex items-center justify-between px-6 h-16 mb-4 border-b border-slate-100">
    <div class="flex items-center gap-3">
      <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[var(--color-brand)] text-white shadow-lg shadow-orange-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </div>
      <span class="text-lg font-bold text-slate-900 tracking-wide">Momba<span class="text-[var(--color-brand)]">POS</span></span>
    </div>
    
    <!-- Close Button (Mobile) -->
    <button data-action="click->sidebar#close" class="md:hidden p-1 text-slate-400 hover:text-slate-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Scrollable Nav -->
  <div class="flex-1 overflow-y-auto py-2 px-3 space-y-1 custom-scrollbar">
    
    <div class="px-3 mb-2 mt-4 text-xs font-semibold uppercase tracking-wider text-slate-400">Principal</div>
    
