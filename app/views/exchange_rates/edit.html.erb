<% content_for :title, "Editing exchange rate" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editar tasa de cambio</h1>

  <%= render "form", exchange_rate: @exchange_rate %>

  <%= link_to "Mostrar esta tasa de cambio", @exchange_rate, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Regresar a Tasas de Cambio", exchange_rates_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
