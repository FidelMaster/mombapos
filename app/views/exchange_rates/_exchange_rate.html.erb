<div id="<%= dom_id exchange_rate %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Moneda:</strong>
    <%= exchange_rate.currency %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tasa:</strong>
    <%= exchange_rate.rate %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Fecha efectiva:</strong>
    <%= exchange_rate.effective_date %>
  </div>
</div>
